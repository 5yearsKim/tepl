module(name = "tepl", version = "0.1.0")

bazel_dep(name = "rules_cc", version = "0.2.19")
bazel_dep(name = "rules_java", version = "9.3.0")
bazel_dep(name = "rules_shell", version = "0.6.1")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "cli11", version = "2.6.2")
bazel_dep(name = "nlohmann_json", version = "3.12.0.bcr.2")
bazel_dep(name = "tomlplusplus", version = "3.4.0")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")
http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

# Single-header process API; pin the source revision and download checksum.
http_archive(
    name = "subprocess",
    build_file = "//third_party:subprocess.BUILD.bazel",
    sha256 = "31d267e8967c8cb124511129710a664de4d61dffa4d9193ba06545927a877ea0",
    strip_prefix = "subprocess.h-8a4715c126433c0f55abe7c10431830864a18e74",
    type = "tar.gz",
    url = "https://codeload.github.com/sheredom/subprocess.h/tar.gz/8a4715c126433c0f55abe7c10431830864a18e74",
)

# Keep the generator and C++ runtime on the same ANTLR release.
http_file(
    name = "antlr_tool",
    downloaded_file_path = "antlr-4.13.2-complete.jar",
    sha256 = "eae2dfa119a64327444672aff63e9ec35a20180dc5b8090b7a6ab85125df4d76",
    url = "https://www.antlr.org/download/antlr-4.13.2-complete.jar",
)

http_archive(
    name = "antlr_runtime",
    build_file = "//third_party:antlr_runtime.BUILD.bazel",
    sha256 = "0ed13668906e86dbc0dcddf30fdee68c10203dea4e83852b4edb810821bee3c4",
    url = "https://www.antlr.org/download/antlr4-cpp-runtime-4.13.2-source.zip",
)

# Used by the optional C++ runtime and integration tests, not the compiler.
http_archive(
    name = "eggc",
    type = "tar.gz",
    build_file = "//third_party:eggc.BUILD.bazel",
    sha256 = "89d2ffbd7999edb65ae3c180d1c9caf72117fb1e8f1f39bf90107e4bb8d8b4f9",
    strip_prefix = "egg-c-0c28bd5050b85ed10e915b5348c27f760ed31ae5",
    url = "https://codeload.github.com/5yearsKim/egg-c/tar.gz/0c28bd5050b85ed10e915b5348c27f760ed31ae5",
)
