SemanticRule dot_canonical_explicit_05
    semantic-inference: policy=algebraic status=proved
      lhs-graph: Reduce(n8.K, Product(align[n8:lhs](Reduce(n6.K, Product(align[n6:lhs](Reduce(n4.K, Product(align[n4:lhs](Reduce(n2.K, Product(align[n2:lhs](Input(#0)), align[n2:rhs](Input(#1))))), align[n4:rhs](Input(#2))))), align[n6:rhs](Input(#3))))), align[n8:rhs](Input(#4))))
      rhs-graph: Reduce(n17.K, Product(align[n17:lhs](Input(#0)), align[n17:rhs](Reduce(n16.K, Product(align[n16:lhs](Input(#1)), align[n16:rhs](Reduce(n15.K, Product(align[n15:lhs](Input(#2)), align[n15:rhs](Reduce(n14.K, Product(align[n14:lhs](Input(#3)), align[n14:rhs](Input(#4)))))))))))))
      law: ordered-axis-split
      law: paired-axis-selection
      law: reduction-extraction
      law: axis-map-restriction
      verified: capture access + reduction domains + ordered axes + shape + dtype + legality
      lhs-normalized: Reduce(concat(n6.J, gather(n4.J, [0]), gather(gather(gather(n2.J, [0]), [0]), [0]), n2.K), Product(Read(#0, access@0), Read(#1, access@1), Read(#2, access@3), Read(#3, access@5), Read(#4, access@7)))
      rhs-normalized: Reduce(concat(gather(n2.K, [0]), n2.J, gather(gather(gather(n4.J, [0]), [0]), [0]), n6.J), Product(Read(#0, access@9), Read(#1, access@10), Read(#2, access@11), Read(#3, access@12), Read(#4, access@13)))
      declared-conditions:
        ==(len(shape(Input(#0))), 3)
        ==(dtype(Input(#0)), dtype_f32())
        ==(len(shape(Input(#1))), 3)
        ==(index(shape(Input(#0)), 0), index(shape(Input(#1)), 0))
        ==(index(shape(Input(#0)), 2), index(shape(Input(#1)), 1))
        ==(dtype(Input(#1)), dtype_f32())
        ==(len(shape(Input(#2))), 3)
        ==(index(shape(Input(#0)), 0), index(shape(Input(#2)), 0))
        ==(index(shape(Input(#1)), 2), index(shape(Input(#2)), 1))
        ==(dtype(Input(#2)), dtype_f32())
        ==(len(shape(Input(#3))), 3)
        ==(index(shape(Input(#0)), 0), index(shape(Input(#3)), 0))
        ==(index(shape(Input(#2)), 2), index(shape(Input(#3)), 1))
        ==(dtype(Input(#3)), dtype_f32())
        ==(len(shape(Input(#4))), 3)
        ==(index(shape(Input(#0)), 0), index(shape(Input(#4)), 0))
        ==(index(shape(Input(#3)), 2), index(shape(Input(#4)), 1))
        ==(dtype(Input(#4)), dtype_f32())
        m7
      additional-guard: true
      reason: valid for all legal LHS metadata satisfying the declared conditions under the selected arithmetic policy
      let m0 = &&(&&(>(index(shape(Input(#0)), 0), 0), >(index(shape(Input(#0)), 1), 0)), >(index(shape(Input(#0)), 2), 0))
      let m1 = &&(&&(&&(m0, >(index(shape(Input(#1)), 2), 0)), >(index(shape(Input(#2)), 2), 0)), >(index(shape(Input(#3)), 2), 0))
      let m2 = &&(&&(&&(m1, >(index(shape(Input(#4)), 2), 0)), ==(@l1.lhs_contracting_dimensions, [2])), ==(@l1.rhs_contracting_dimensions, [1]))
      let m3 = &&(&&(&&(m2, ==(@l1.lhs_batching_dimensions, [0])), ==(@l1.rhs_batching_dimensions, [0])), ==(@l2.lhs_contracting_dimensions, [2]))
      let m4 = &&(&&(&&(m3, ==(@l2.rhs_contracting_dimensions, [1])), ==(@l2.lhs_batching_dimensions, [0])), ==(@l2.rhs_batching_dimensions, [0]))
      let m5 = &&(&&(m4, ==(@l3.lhs_contracting_dimensions, [2])), ==(@l3.rhs_contracting_dimensions, [1]))
      let m6 = &&(&&(&&(m5, ==(@l3.lhs_batching_dimensions, [0])), ==(@l3.rhs_batching_dimensions, [0])), ==(@l4.lhs_contracting_dimensions, [2]))
      let m7 = &&(&&(&&(m6, ==(@l4.rhs_contracting_dimensions, [1])), ==(@l4.lhs_batching_dimensions, [0])), ==(@l4.rhs_batching_dimensions, [0]))
      let m8 = concat(gather(gather(gather(n2.B, [0]), [0]), [0]), gather(gather(gather(n2.J, [0]), [0]), [0]), n4.J)
      let m9 = concat(gather(gather(gather(n2.B, [0]), [0]), [0]), gather(gather(gather(n2.I, [0]), [0]), [0]), n4.J)
      let m10 = concat(filter_axes(m9, gather(gather(gather(n2.B, [0]), [0]), [0])), gather(n4.J, [0]), n6.J)
      let m11 = concat(gather(gather(filter_axes(m9, gather(gather(gather(n2.B, [0]), [0]), [0])), [0]), [0]), n6.J, n8.J)
      let m12 = concat(gather(gather(filter_axes(m9, gather(gather(gather(n2.B, [0]), [0]), [0])), [0]), [0]), filter_axes(m9, gather(gather(gather(n2.I, [0]), [0]), [0])), n8.J)
      coordinate frame (fresh identities; domain lengths remain symbolic):
        input0 = group(extents=shape(Input(#0)))
        input1 = group(extents=shape(Input(#1)))
        n2.B = group(extents=gather(shape(Input(#0)), [0]))
        n2.K = group(extents=gather(shape(Input(#0)), [2]))
        n2.I = group(extents=gather(shape(Input(#0)), [1]))
        n2.J = group(extents=gather(shape(Input(#1)), [2]))
        input3 = group(extents=shape(Input(#2)))
        n4.J = group(extents=gather(shape(Input(#2)), [2]))
        input5 = group(extents=shape(Input(#3)))
        n6.J = group(extents=gather(shape(Input(#3)), [2]))
        input7 = group(extents=shape(Input(#4)))
        n6.J = group(extents=gather(shape(Input(#3)), [2]))
        n8.J = group(extents=gather(shape(Input(#4)), [2]))
        access@0 = gather(concat(n2.B, n2.K, n2.I), [0, 2, 1])
        access@1 = gather(concat(n2.B, n2.K, n2.J), [0, 1, 2])
        access@3 = gather(m8, [0, 1, 2])
        access@5 = gather(m10, [0, 1, 2])
        access@7 = gather(m11, [0, 1, 2])
        access@9 = gather(concat(n2.B, n2.K, n2.I), [0, 2, 1])
        access@10 = gather(concat(n2.B, n2.K, n2.J), [0, 1, 2])
        access@11 = gather(m8, [0, 1, 2])
        access@12 = gather(m10, [0, 1, 2])
        access@13 = gather(m11, [0, 1, 2])
        lhs-output = m12
        rhs-output = concat(gather(n2.B, [0]), gather(n2.I, [0]), n8.J)
