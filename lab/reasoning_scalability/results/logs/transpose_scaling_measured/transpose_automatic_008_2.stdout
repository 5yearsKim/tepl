SemanticRule transpose_automatic_008
    semantic-inference: policy=algebraic status=proved
      lhs-graph: align[n8:input](align[n7:input](align[n6:input](align[n5:input](align[n4:input](align[n3:input](align[n2:input](align[n1:input](Input(#0)))))))))
      rhs-graph: align[n10:input](Input(#0))
      law: ordered-axis-split
      law: paired-axis-selection
      law: ordered-partition-traversal
      law: axis-map-restriction
      verified: capture access + reduction domains + ordered axes + shape + dtype + legality
      lhs-normalized: Read(#0, access@0)
      rhs-normalized: Read(#0, access@9)
      constructor auto#8:
        permutation = m1
      declared-conditions:
        ==(len(shape(Input(#0))), 3)
        ==(dtype(Input(#0)), dtype_f32())
        m2
      additional-guard: true
      reason: valid for all legal LHS metadata satisfying the declared conditions under the selected arithmetic policy
      let m0 = gather(@p5.permutation, gather(@p6.permutation, gather(@p7.permutation, @p8.permutation)))
      let m1 = gather(@p1.permutation, gather(@p2.permutation, gather(@p3.permutation, gather(@p4.permutation, m0))))
      let m2 = &&(&&(>(index(shape(Input(#0)), 0), 0), >(index(shape(Input(#0)), 1), 0)), >(index(shape(Input(#0)), 2), 0))
      coordinate frame (fresh identities; domain lengths remain symbolic):
        input0 = group(extents=shape(Input(#0)))
        input0 = group(extents=shape(Input(#0)))
        access@0 = input0
        access@9 = input0
        lhs-output = gather(input0, m1)
        rhs-output = gather(input0, m1)
