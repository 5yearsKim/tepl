SemanticRule transpose_automatic_004
    semantic-inference: policy=algebraic status=proved
      lhs-graph: align[n4:input](align[n3:input](align[n2:input](align[n1:input](Input(#0)))))
      rhs-graph: align[n6:input](Input(#0))
      law: ordered-axis-split
      law: paired-axis-selection
      law: ordered-partition-traversal
      law: axis-map-restriction
      verified: capture access + reduction domains + ordered axes + shape + dtype + legality
      lhs-normalized: Read(#0, access@0)
      rhs-normalized: Read(#0, access@5)
      constructor auto#4:
        permutation = m0
      declared-conditions:
        ==(len(shape(Input(#0))), 3)
        ==(dtype(Input(#0)), dtype_f32())
        m1
      additional-guard: true
      reason: valid for all legal LHS metadata satisfying the declared conditions under the selected arithmetic policy
      let m0 = gather(@p1.permutation, gather(@p2.permutation, gather(@p3.permutation, @p4.permutation)))
      let m1 = &&(&&(>(index(shape(Input(#0)), 0), 0), >(index(shape(Input(#0)), 1), 0)), >(index(shape(Input(#0)), 2), 0))
      coordinate frame (fresh identities; domain lengths remain symbolic):
        input0 = group(extents=shape(Input(#0)))
        input0 = group(extents=shape(Input(#0)))
        access@0 = input0
        access@5 = input0
        lhs-output = gather(input0, m0)
        rhs-output = gather(input0, m0)
