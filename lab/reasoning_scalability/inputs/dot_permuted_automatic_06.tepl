from "../../../examples/semantic/dialects/tensor.tepl" import TensorLang as t;
use t::{dot, add, mul};

rule dot_permuted_automatic_06 {
    A1: f32[B, D0, D1]
    A2: f32[B, D2, D1]
    A3: f32[D2, B, D3]
    A4: f32[D3, D4, B]
    A5: f32[D5, B, D4]
    A6: f32[D6, D5, B]

    (dot[@l5] (dot[@l4] (dot[@l3] (dot[@l2] (dot[@l1] A1 A2) A3) A4) A5) A6)
    =>
    (dot[auto] A1 (dot[auto] A2 (dot[auto] A3 (dot[auto] A4 (dot[auto] A5 A6)))))
    where {
        B > 0
        && D0 > 0
        && D1 > 0
        && D2 > 0
        && D3 > 0
        && D4 > 0
        && D5 > 0
        && D6 > 0
        && @l1.lhs_contracting_dimensions == [2]
        && @l1.rhs_contracting_dimensions == [2]
        && @l1.lhs_batching_dimensions == [0]
        && @l1.rhs_batching_dimensions == [0]
        && @l2.lhs_contracting_dimensions == [2]
        && @l2.rhs_contracting_dimensions == [0]
        && @l2.lhs_batching_dimensions == [0]
        && @l2.rhs_batching_dimensions == [1]
        && @l3.lhs_contracting_dimensions == [2]
        && @l3.rhs_contracting_dimensions == [0]
        && @l3.lhs_batching_dimensions == [0]
        && @l3.rhs_batching_dimensions == [2]
        && @l4.lhs_contracting_dimensions == [2]
        && @l4.rhs_contracting_dimensions == [2]
        && @l4.lhs_batching_dimensions == [0]
        && @l4.rhs_batching_dimensions == [1]
        && @l5.lhs_contracting_dimensions == [2]
        && @l5.rhs_contracting_dimensions == [1]
        && @l5.lhs_batching_dimensions == [0]
        && @l5.rhs_batching_dimensions == [2]
    }
}
