from "../../../examples/semantic/dialects/tensor.tepl" import TensorLang as t;
use t::{dot, add, mul};

rule product_08 {
    A1: f32[M, N]
    B1: f32[M, N]
    A2: f32[M, N]
    B2: f32[M, N]
    A3: f32[M, N]
    B3: f32[M, N]
    A4: f32[M, N]
    B4: f32[M, N]
    A5: f32[M, N]
    B5: f32[M, N]
    A6: f32[M, N]
    B6: f32[M, N]
    A7: f32[M, N]
    B7: f32[M, N]
    A8: f32[M, N]
    B8: f32[M, N]

    (mul (mul (mul (mul (mul (mul (mul (add A1 B1) (add A2 B2)) (add A3 B3)) (add A4 B4)) (add A5 B5)) (add A6 B6)) (add A7 B7)) (add A8 B8))
    =>
    (mul (mul (mul (mul (mul (mul (mul (add A8 B8) (add A7 B7)) (add A6 B6)) (add A5 B5)) (add A4 B4)) (add A3 B3)) (add A2 B2)) (add A1 B1))
    where { M > 0 && N > 0 }
}
