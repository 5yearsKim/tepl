from "../../../examples/semantic/dialects/tensor.tepl" import TensorLang as t;
use t::{dot, add, mul};

rule dot_permuted_explicit_04 {
    A1: f32[B, D0, D1]
    A2: f32[B, D2, D1]
    A3: f32[D2, B, D3]
    A4: f32[D3, D4, B]

    (dot[@l3] (dot[@l2] (dot[@l1] A1 A2) A3) A4)
    =>
    (dot[@r1] A1 (dot[@r2] A2 (dot[@r3] A3 A4)))
    where {
        B > 0
        && D0 > 0
        && D1 > 0
        && D2 > 0
        && D3 > 0
        && D4 > 0
        && @l1.lhs_contracting_dimensions == [2]
        && @l1.rhs_contracting_dimensions == [2]
        && @l1.lhs_batching_dimensions == [0]
        && @l1.rhs_batching_dimensions == [0]
        && @l2.lhs_contracting_dimensions == [2]
        && @l2.rhs_contracting_dimensions == [0]
        && @l2.lhs_batching_dimensions == [0]
        && @l2.rhs_batching_dimensions == [1]
        && @l3.lhs_contracting_dimensions == [2]
        && @l3.rhs_contracting_dimensions == [0]
        && @l3.lhs_batching_dimensions == [0]
        && @l3.rhs_batching_dimensions == [2]
    }
    derive {
        @r3 = { lhs_contracting_dimensions: [2], rhs_contracting_dimensions: [0], lhs_batching_dimensions: [1], rhs_batching_dimensions: [2] };
        @r2 = { lhs_contracting_dimensions: [1], rhs_contracting_dimensions: [1], lhs_batching_dimensions: [0], rhs_batching_dimensions: [0] };
        @r1 = { lhs_contracting_dimensions: [2], rhs_contracting_dimensions: [1], lhs_batching_dimensions: [0], rhs_batching_dimensions: [0] };
    }
}
