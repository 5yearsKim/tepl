from "../../../../examples/semantic/dialects/tensor.tepl" import TensorLang as t;
use t::{transpose};

rule transpose_explicit_002 {
    A: f32[D0,D1,D2]
    (transpose[@p2] (transpose[@p1] A))
    =>
    (transpose[@combined] A)
    where { D0 > 0 && D1 > 0 && D2 > 0 }
    derive { @combined = { permutation: gather(@p1.permutation, @p2.permutation) }; }
}
