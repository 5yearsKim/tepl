from "../../../../examples/semantic/dialects/tensor.tepl" import TensorLang as t;
use t::{transpose};

rule transpose_automatic_016 {
    A: f32[D0,D1,D2]
    (transpose[@p16] (transpose[@p15] (transpose[@p14] (transpose[@p13] (transpose[@p12] (transpose[@p11] (transpose[@p10] (transpose[@p9] (transpose[@p8] (transpose[@p7] (transpose[@p6] (transpose[@p5] (transpose[@p4] (transpose[@p3] (transpose[@p2] (transpose[@p1] A))))))))))))))))
    =>
    (transpose[auto] A)
    where { D0 > 0 && D1 > 0 && D2 > 0 }
}
