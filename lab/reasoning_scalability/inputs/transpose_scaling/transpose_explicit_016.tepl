from "../../../../examples/semantic/dialects/tensor.tepl" import TensorLang as t;
use t::{transpose};

rule transpose_explicit_016 {
    A: f32[D0,D1,D2]
    (transpose[@p16] (transpose[@p15] (transpose[@p14] (transpose[@p13] (transpose[@p12] (transpose[@p11] (transpose[@p10] (transpose[@p9] (transpose[@p8] (transpose[@p7] (transpose[@p6] (transpose[@p5] (transpose[@p4] (transpose[@p3] (transpose[@p2] (transpose[@p1] A))))))))))))))))
    =>
    (transpose[@combined] A)
    where { D0 > 0 && D1 > 0 && D2 > 0 }
    derive { @combined = { permutation: gather(gather(gather(gather(gather(gather(gather(gather(gather(gather(gather(gather(gather(gather(gather(@p1.permutation, @p2.permutation), @p3.permutation), @p4.permutation), @p5.permutation), @p6.permutation), @p7.permutation), @p8.permutation), @p9.permutation), @p10.permutation), @p11.permutation), @p12.permutation), @p13.permutation), @p14.permutation), @p15.permutation), @p16.permutation) }; }
}
