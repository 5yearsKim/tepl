from "../../../../examples/semantic/dialects/tensor.tepl" import TensorLang as t;
use t::{transpose};

rule transpose_explicit_008 {
    A: f32[D0,D1,D2]
    (transpose[@p8] (transpose[@p7] (transpose[@p6] (transpose[@p5] (transpose[@p4] (transpose[@p3] (transpose[@p2] (transpose[@p1] A))))))))
    =>
    (transpose[@combined] A)
    where { D0 > 0 && D1 > 0 && D2 > 0 }
    derive { @combined = { permutation: gather(gather(gather(gather(gather(gather(gather(@p1.permutation, @p2.permutation), @p3.permutation), @p4.permutation), @p5.permutation), @p6.permutation), @p7.permutation), @p8.permutation) }; }
}
