from "../../../examples/semantic/dialects/tensor.tepl" import TensorLang as t;
use t::{dot, add, mul};

rule dot_permuted_automatic_03 {
    A1: f32[B, D0, D1]
    A2: f32[B, D2, D1]
    A3: f32[D2, B, D3]

    (dot[@l2] (dot[@l1] A1 A2) A3)
    =>
    (dot[auto] A1 (dot[auto] A2 A3))
    where {
        B > 0
        && D0 > 0
        && D1 > 0
        && D2 > 0
        && D3 > 0
        && @l1.lhs_contracting_dimensions == [2]
        && @l1.rhs_contracting_dimensions == [2]
        && @l1.lhs_batching_dimensions == [0]
        && @l1.rhs_batching_dimensions == [0]
        && @l2.lhs_contracting_dimensions == [2]
        && @l2.rhs_contracting_dimensions == [0]
        && @l2.lhs_batching_dimensions == [0]
        && @l2.rhs_batching_dimensions == [1]
    }
}
