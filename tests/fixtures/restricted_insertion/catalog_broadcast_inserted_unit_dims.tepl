// From paper evaluation/unified-construction/inputs/catalog_broadcast_inserted_unit_dims.tepl
// Only syntax migration and dialect qualification; guards and supplied fields retained.
rule catalog_broadcast_inserted_unit_dims {
    X: [N]
     (attr_b: TensorLang.broadcast (axis_eval_0: TensorLang.broadcast X)) => (attr_out: TensorLang.broadcast X)
     where  [1,N] == [1,N] && attr_b.attrs.dimensions == [0,1]  && (axis_eval_0.attrs.dimensions == [1]) && (axis_eval_0.attrs.new_extents == [1])
     
derive {
 attr_out.attrs = {dimensions: auto, new_extents: concat([1], attr_b.attrs.new_extents)}
}
}
