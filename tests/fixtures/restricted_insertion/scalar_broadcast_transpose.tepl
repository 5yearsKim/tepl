// From paper evaluation/unified-construction/inputs/scalar_broadcast_transpose.tepl
// Only syntax migration and dialect qualification; guards and supplied fields retained.
rule scalar_broadcast_transpose {
    (attr_p: transpose (attr_b: broadcast C)) => (attr_out: broadcast C)
    where  attr_b.attrs.dimensions == [] && len(attr_b.attrs.new_extents) == 2
         && attr_p.attrs.permutation == [1, 0] 
    
derive {
 attr_out.attrs = {dimensions: auto, new_extents: gather(attr_b.attrs.new_extents, [1, 0])}
}
}
