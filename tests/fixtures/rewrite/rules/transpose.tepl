from "dialects/tensor.tepl" import TensorLang as t

rule compose_transposes {
  (outer: t.transpose (inner: t.transpose X)) => (result: t.transpose X)

  derive {
    result.attrs = {
      permutation: gather(inner.attrs.permutation, outer.attrs.permutation)
    }
  }
}

rule remove_identity {
  X: [Dims...]

  (node: t.transpose X) => X

  where node.attrs.permutation == range(len(Dims))
}
