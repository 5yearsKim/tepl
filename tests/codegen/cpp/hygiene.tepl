dialect Hygiene {
    attrs Value { seed: index; }
    attrs Arity { seed: string; }
    op value_copy(x: tensor) -> tensor {
        attrs: Value; dtype(t0) { yield t0; } shape(s) { yield s; }
    }
    op arity_copy(x: tensor) -> tensor {
        attrs: Arity; dtype(t0) { yield t0; } shape(s) { yield s; }
    }
}
rule identity { (value_copy[@a] X) => (value_copy[@a] X) }
rule eliminate { (arity_copy[@a] X) => X }

graph example {
    input X: f32[2];
    let N = (Hygiene.value_copy[seed = 1] X);
    yield (Hygiene.arity_copy[seed = "one"] N);
}
