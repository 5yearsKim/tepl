dialect D {
  attrs Size {n:u64;}
  op source(x:tensor)->tensor {attrs:Size;dtype(t){yield t;}}
  op output(x:tensor)->tensor {attrs:Size;dtype(t){yield t;}shape(s){yield [attrs.n];}}
}
rule convert {
  (source:D.source X) => (result:D.output X)
  derive {result.attrs={n:source.attrs.n};}
}
graph g {input X:f32[4];yield (D.source[n=2] X);}
