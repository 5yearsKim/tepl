dialect Unfamiliar {
    op fuse(lhs: tensor, rhs: tensor) -> tensor {
        dtype: same_numeric;
        shape(l, r) { assert l == r; yield l; }
    }
    // A familiar name provides no implicit semantics.
    op add(input: tensor) -> tensor;
    op shape_only(input: tensor) -> tensor { shape(s) { yield s; } }
    op dtype_only(input: tensor) -> tensor { dtype: same; }
    op floats(input: tensor) -> tensor {
        dtype: same_float;
        shape(s) { yield s; }
    }
    op boolean(input: tensor) -> tensor {
        dtype: bool;
        shape(s) { yield s; }
    }
    op variadic(inputs: tensor...) -> tensor {
        dtype: same;
        shape(inputs...) { yield concat([], [sum(s) for s in inputs]); }
    }
    op tail(first: tensor, rest: tensor...) -> tensor {
        dtype: same;
        shape(first, rest...) {
            assert all([len(s) == len(first) for s in rest]);
            yield concat(first, [sum(s) for s in rest]);
        }
    }
    op utilities(input: tensor) -> tensor {
        dtype: same;
        attrs { flags: bool[]; nested: bool[][]; padding: i64[][]; rank: i64; match: bool; }
        shape(s) {
            let a = [1, 2, 3];
            assert len(a) == 3;
            assert range(3) == [0, 1, 2];
            assert concat(a, [], [4]) == [1, 2, 3, 4];
            assert gather(a, [2, 0, 2]) == [3, 1, 3];
            assert exclude(a, [2]) == [1, 3];
            assert slice(a, 1, 3) == [2, 3];
            assert replace(a, 1, 9) == [1, 9, 3];
            assert sum(a) == 6 && product(a) == 6;
            assert attrs.match;
            assert all(attrs.flags) && any(attrs.flags);
            assert contains(a, 2) && contains(attrs.nested, [true, false]);
            assert is_valid_axis_list([0, 1], sum([attrs.rank]));
            assert is_disjoint([0, 2], [1]);
            assert broadcast_shape([2, 1], [3]) == [2, 3];
            assert broadcast_shape([18446744073709551616], [1])[0] / 2 == 9223372036854775808;
            assert min(-3, 2) == -3 && max(-3, 2) == 2;
            assert floor_div(-7, 3) == -3 && ceil_div(-7, 3) == -2;
            assert -7 / 3 == -2 && -7 % 3 == -1;
            assert +2 * 3 + 1 - 1 == 6;
            assert attrs.padding[0][0] == -2;
            assert concat([[1]], [[2]]) == [[1], [2]];
            assert gather(attrs.nested, [0]) == [[true, false]];
            assert [sum(row) for row in [[1, 2], [3]]] == [3, 3];
            assert [[value + 1 for value in row] for row in [[1, 2], [3]]] == [[2, 3], [4]];
            assert (if false then [1 / 0] else a) == a;
            yield s;
        }
    }
    op branches(input: tensor) -> tensor {
        dtype: same;
        shape(s) {
            assert true || s[999] == 0;
            assert !(false && 1 / 0 == 0);
            let chosen = if true then s else [1 / 0];
            yield [if i == 0 then chosen[i] else chosen[i] + 1
                   for i in range(len(chosen))];
        }
    }
    op output(input: tensor) -> tensor {
        dtype: same;
        attrs { shape: i64[]; }
        shape(s) { yield attrs.shape; }
    }
    op overflow() -> tensor {
        dtype: f32;
        shape() { yield [170141183460469231731687303715884105727 * 2]; }
    }
    op minimum() -> tensor {
        dtype: f32;
        shape() {
            let minimum = -170141183460469231731687303715884105728;
            assert minimum + 1 == -170141183460469231731687303715884105727;
            assert false || true;
            yield [];
        }
    }
    op stopped(input: tensor) -> tensor {
        dtype: same;
        shape(s) { assert false; yield [1 / 0]; }
    }
}
rule commute {
    X: f32[N]
    Y: f32[N]
    (fuse X Y) => (fuse Y X)
}
rule bad_output {
    X: f32[N]
    X => (boolean X)
}
