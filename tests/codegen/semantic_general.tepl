// Optional element semantics; see ../README.md for the supported proof fragment.
dialect TensorLang {
    op add(lhs: tensor, rhs: tensor) -> tensor {
        dtype(a, b) {
            assert a == b;
            assert is_numeric(a);
            yield a;
        }
        shape(l, r) {
            assert l == r;
            yield l;
        }
        semantics(out_idx) {
            yield read(lhs, out_idx) + read(rhs, out_idx);
        }
    }

    op dot_general(lhs: tensor, rhs: tensor) -> tensor {
        // TEPL shorthand, not a separate StableHLO dot operation.
        alias: dot;
        dtype(a, b) {
            assert a == b;
            assert is_numeric(a);
            yield a;
        }
        attrs {
            // Flattened fields of StableHLO dot_dimension_numbers.
            lhs_contracting_dimensions: index[];
            rhs_contracting_dimensions: index[];
            lhs_batching_dimensions: index[];
            rhs_batching_dimensions: index[];
        }
        shape(l, r) {
            let lc = attrs.lhs_contracting_dimensions;
            let rc = attrs.rhs_contracting_dimensions;
            let lb = attrs.lhs_batching_dimensions;
            let rb = attrs.rhs_batching_dimensions;
            assert is_valid_axis_list(lc, len(l));
            assert is_valid_axis_list(rc, len(r));
            assert is_valid_axis_list(lb, len(l));
            assert is_valid_axis_list(rb, len(r));
            assert is_disjoint(lb, lc);
            assert is_disjoint(rb, rc);
            assert len(lb) == len(rb);
            assert len(lc) == len(rc);
            assert gather(l, lb) == gather(r, rb);
            assert gather(l, lc) == gather(r, rc);
            let lf = exclude(range(len(l)), concat(lb, lc));
            let rf = exclude(range(len(r)), concat(rb, rc));
            yield concat(gather(l, lb), gather(l, lf), gather(r, rf));
        }
        // Ideal mathematical contraction; numerical policy is checked separately.
        semantics(out_idx) {
            let lb = attrs.lhs_batching_dimensions;
            let rb = attrs.rhs_batching_dimensions;
            let lc = attrs.lhs_contracting_dimensions;
            let rc = attrs.rhs_contracting_dimensions;

            let lf = exclude(range(rank(lhs)), concat(lb, lc));
            let rf = exclude(range(rank(rhs)), concat(rb, rc));

            // Output axes: batch, lhs free, rhs free.
            let b = take(out_idx, 0, len(lb));
            let i = take(out_idx, len(lb), len(lf));
            let j = take(out_idx, len(lb) + len(lf), len(rf));

            yield sum(k in index_space(gather(shape(lhs), lc))) {
                let li = scatter(
                    rank(lhs),
                    concat(lb, lf, lc),
                    concat(b, i, k)
                );
                let ri = scatter(
                    rank(rhs),
                    concat(rb, rf, rc),
                    concat(b, j, k)
                );

                read(lhs, li) * read(rhs, ri)
            };
        }
    }

    op transpose(input: tensor) -> tensor {
        attrs {
            permutation: index[];
        }
        dtype(t) {
            yield t;
        }
        shape(s) {
            assert is_valid_axis_list(attrs.permutation, len(s));
            assert len(attrs.permutation) == len(s);
            yield gather(s, attrs.permutation);
        }
        semantics(out_idx) {
            // Output axis i corresponds to input axis permutation[i].
            let in_idx = scatter(rank(input), attrs.permutation, out_idx);
            yield read(input, in_idx);
        }
    }
    attrs Reduction { reduced: index[]; }
    op fold(input: tensor) -> tensor {
        attrs: Reduction;
        dtype(t) { yield t; }
        shape(s) {
            assert is_valid_axis_list(attrs.reduced, len(s));
            yield gather(s, exclude(range(len(s)), attrs.reduced));
        }
        semantics(out_idx) {
            let free = exclude(range(rank(input)), attrs.reduced);
            yield sum(k in index_space(gather(shape(input), attrs.reduced))) {
                read(input, scatter(rank(input), concat(free, attrs.reduced), concat(out_idx, k)))
            };
        }
    }
    op squared_sum(input: tensor) -> tensor {
        attrs: Reduction;
        dtype(t) { yield t; }
        shape(s) {
            assert is_valid_axis_list(attrs.reduced, len(s));
            yield gather(s, exclude(range(len(s)), attrs.reduced));
        }
        semantics(out_idx) {
            let free = exclude(range(rank(input)), attrs.reduced);
            let s = sum(k in index_space(gather(shape(input), attrs.reduced))) {
                read(input, scatter(rank(input), concat(free, attrs.reduced), concat(out_idx, k)))
            };
            yield s * s;
        }
    }
}

use TensorLang::{dot,transpose,add,fold,squared_sum};
rule identity { (dot[@d] A B) => (dot[auto] (transpose[auto] A) B) }
rule cycle { (dot[@d] A B) => (dot[auto] (transpose[auto, permutation=[1,2,0]] A) B) }
rule distribute { (dot[@d] (add A B) C) => (add (dot[auto] A C) (dot[auto] B C)) }
rule associate { (dot[@outer] (dot[@inner] A B) C) => (dot[auto] A (dot[auto] B C)) }
rule lora { (dot[@outer] X (add W (dot[@inner] A B))) => (add (dot[auto] X W) (dot[auto] (dot[auto] X A) B)) }

// Output transposition is valid for an outer product of a vector with itself.
// This exercises repeated capture ports, rather than a named rewrite handler.
rule symmetric_product {
    (dot[@d] A A)
    =>
    (transpose[auto, permutation=[1,0]] (dot[@d] A A))
}
rule invalid_drop_operand {
    (dot[@d] A B)
    =>
    (transpose[auto] A)
}

rule associate_reverse {
    (dot[@outer] A (dot[@inner] B C))
    =>
    (dot[auto] (dot[auto] A B) C)
}
rule lora_partial {
    (dot[@outer] X (add W (dot[@inner] A B)))
    =>
    (add (dot[@outer] X W) (dot[auto] (dot[auto] X A) B))
}

rule reused_reduction {
    (squared_sum[@s] A)
    =>
    (dot[auto] (fold[@s] A) (fold[@s] A))
}

rule bound_intermediate {
    let Y = (dot[@d] A B)
    =>
    (transpose[auto] Y)
}
