dialect Custom {
    attrs Axes { axis: index; tags: string[] = []; }
    op input() -> tensor { attrs { name: string; } }
    op add(lhs: tensor, rhs: tensor) -> tensor { alias: plus; }
    op negate(input: tensor) -> tensor;
    op transform(input: tensor) -> tensor { attrs: Axes; }
    op another(input: tensor) -> tensor { attrs { size: index; } }
    op concat(first: tensor, rest: tensor...) -> tensor;
    // Different operation names remain local to this dialect.
    op foo_bar(input: tensor) -> tensor;
    op foo_other(input: tensor) -> tensor;
}
from "other.tepl" import Other;
from "mirror.tepl" import Mirror as duplicate;

rule commute {
    X: [M, Batch..., N]
    Y: [M, Batch..., N]
    (Custom.plus X Y) => (Custom.add Y X)
    where { M >= 1 && N <= 128; }
}
rule bind {
    (Custom.add (let Y = (Custom.negate X)) Y) => Y
}
rule literal_any { (Custom.add X 1) => (Custom.add 1 X) }
rule literal_typed { (Custom.add X 1:i32) => (Custom.add 1:i32 X) }
rule construct_literal { (Custom.negate X) => (Custom.add X 2) }
rule derive_chain {
    (Custom.transform[@d] X) => (Custom.transform[@last] X)
    where { enabled(X, @d); }
    derive {
        @first = update(@d);
        @last = update(@first);
    }
}
rule reuse_attrs { (Custom.transform[@d] X) => (Custom.transform[@d] X) }
rule short_circuit {
    (Custom.negate X) => X
    where { true || fails(X); false && fails(X) || true; }
}
rule overflow {
    X: [N]
    (Custom.negate X) => X
    where { N + 1 > N; }
}
rule divide_zero {
    X: [N]
    (Custom.negate X) => X
    where { N / 0 > 1; }
}
rule nested_calls {
    X: [N]
    (Custom.negate X) => X
    where { greater(twice(N) + 0, 1); }
}
rule signed_float {
    (Custom.negate X) => X
    where { signed(X) + -1 > -3; floating(X) * 2.0 < 100.0; }
}
rule reserved_names {
    (Custom.negate X) => X
    where { match(X); }
}
rule variadic { (Custom.concat X Y Z) => (Custom.concat X) }

abstract rule restrict() {
    X: [_, Batch..., N]
    (Custom.negate X) => X
}
rule inherited extends restrict() {
    X: f32[M, _, N]
    where { M > 0; N > 0; }
}

abstract rule pipeline(
    copy: fn<(tensor) -> tensor>,
    copy_dims: fn<(index_list) -> index_list>,
    check: fn<(tensor, index_list, bool, i64, f64, attrs) -> bool>
) {
    X: [Batch...]
    (Custom.transform[@d] X) => (Custom.negate X)
    where { check(copy(X), copy_dims(Batch), !false, -1, +1.0, @d); }
}
rule typed_pipeline extends pipeline(copy = host_tensor, copy_dims = host_dims, check = host_check);
rule short_literal {
    (Custom.negate X) => 1
    where { true || fails(X); }
}
