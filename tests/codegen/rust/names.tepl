dialect Type {
  attrs String {note:string;}
  attrs Vec {axes:index[];}
  attrs Option {enabled:bool?;}
  attrs Match { type:index; match:bool; gen:index; }
  op type(x:tensor)->tensor {
    attrs:Match;
    dtype(t){yield t;}
    shape(s){assert attrs.match;assert attrs.type==attrs.gen;yield s;}
  }
}
dialect Std {op std_copy(x:tensor)->tensor;}
dialect Egg {op egg_copy(x:tensor)->tensor;}
rule match {(Type.type[@d] X)=>(Type.type[@d] X) where {@d.match}}
graph type { input X:f32[2];yield (Type.type[type=1,match=true,gen=1] X); }
