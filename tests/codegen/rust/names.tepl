dialect Type {
  attrs String {
    note: string
  }

  attrs Vec {
    axes: u64[]
  }

  attrs Option {
    enabled: bool?
  }

  attrs Match {
    type: u64
    match: bool
    gen: u64
  }

  op type(x: tensor) -> tensor {
    attrs: Match
    dtype(t) {
      yield t
    }
    shape(s) {
      assert attrs.match
      assert attrs.type == attrs.gen
      yield s
    }
  }
}

dialect Std {
  op std_copy(x: tensor) -> tensor
}

dialect Egg {
  op egg_copy(x: tensor) -> tensor
}

rule match {
  (d: Type.type X) => (Type.type[d.attrs] X)

  where d.attrs.match
}

graph type {
  input X: f32[2]

  yield (Type.type[type = 1, match = true, gen = 1] X)
}
