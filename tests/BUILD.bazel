load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

cc_test(
    name = "core_test",
    size = "small",
    srcs = ["core_test.cc"],
    args = [
        "$(rlocationpath //examples:rules/lora.tepl)",
        "$(rlocationpath //examples:rules/inherited.tepl)",
    ],
    data = [
        "//examples:rules/lora.tepl",
        "//examples:rules/inherited.tepl",
        "//examples:rules/abstract.tepl",
        "//examples:dialects/tensor.tepl",
    ],
    deps = [
        "//:frontend",
        "//:imports",
        "//src/ast:ast",
        "//src/core:analysis",
        "//src/core:print",
        "@rules_cc//cc/runfiles",
    ],
)

sh_test(
    name = "cli_test",
    size = "small",
    srcs = ["cli_test.sh"],
    args = [
        "$(rootpath //:tepl)",
        "$(rootpath //examples:rules/simple.tepl)",
    ],
    data = [
        "//:tepl",
        "//examples:rules/simple.tepl",
        "//examples:dialects/tensor.tepl",
        "//examples:rules/abstract.tepl",
        "//examples:rules/inherited.tepl",
        "//examples:rules/basic.tepl",
    ],
)

cc_test(
    name = "ast_test",
    size = "small",
    srcs = ["ast_test.cc"],
    args = [
        "$(rlocationpath //examples:rules/lora.tepl)",
        "$(rlocationpath //examples:dialects/tensor.tepl)",
        "$(rlocationpath //examples:rules/abstract.tepl)",
        "$(rlocationpath //examples:rules/inherited.tepl)",
    ],
    data = [
        "//examples:rules/lora.tepl",
        "//examples:dialects/tensor.tepl",
        "//examples:rules/abstract.tepl",
        "//examples:rules/inherited.tepl",
    ],
    deps = [
        "//src/ast:ast",
        "//:frontend",
        "//:imports",
        "@rules_cc//cc/runfiles",
    ],
)

cc_test(
    name = "syntax_test",
    size = "small",
    srcs = ["syntax_test.cc"],
    deps = [
        "//:frontend",
        "//grammar:parser",
    ],
)

cc_test(
    name = "dtype_test",
    size = "small",
    srcs = ["dtype_test.cc"],
    deps = [
        "//:frontend",
        "//src/ast:ast",
    ],
)

cc_test(
    name = "codegen_test",
    size = "small",
    srcs = ["codegen_test.cc"],
    deps = [
        "//:frontend",
        "//src/codegen:codegen",
        "//src/core:analysis",
    ],
)

# Requires the machine's Cargo/Rust toolchain and Cargo dependencies.
# Explicitly run this target, or tools/test_codegen.sh, for runtime integration.
sh_test(
    name = "rust_codegen_test",
    size = "large",
    srcs = ["codegen_integration_test.sh"],
    args = ["$(rootpath //:tepl)"],
    data = [
        "//:tepl",
        "//:tools/test_codegen.sh",
        "//examples:all",
    ] + glob(["codegen/*.tepl", "codegen/*.rs"]),
    tags = ["local", "manual"],
    env_inherit = ["PATH", "HOME", "CARGO_HOME", "RUSTUP_HOME"],
)
