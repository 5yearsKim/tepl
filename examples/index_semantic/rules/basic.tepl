from "../dialects/tensor.tepl" import TensorLang as t;
use t::{dot, transpose};

// Symbolic construction chooses an identity transpose and preserves dot attrs.
rule transpose_dot_lhs {
    (dot[@d] A B)
    =>
    (dot[auto] (transpose[auto] A) B)
}

// This permutation preserves free-axis order only on guarded matching instances.
rule transpose_dot_cycle {
    (dot[@d] A B)
    =>
    (dot[auto] (transpose[auto, permutation = [1, 2, 0]] A) B)
}
