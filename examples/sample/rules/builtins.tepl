from "../dialects/tensor.tepl" import TensorLang as t;

// Shape declarations prune candidates during search. Builtin conditions run
// during application using the generated common runtime, without host methods.
rule cancel_negate_small {
    X: [Dims...]

    (t.negate (t.negate X)) => X

    where {
        len(Dims) <= 4;
        product(Dims) <= 4096;
    }
}
