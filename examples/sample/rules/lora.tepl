from "dialects/tensor.tepl" import TensorLang as t;
use t::{add, dot};

// Algebraic identity: select only when the numerical policy permits distribution
// and reassociation. These guards specify equal-batch matrix contractions.
rule lora {
    X: [Batch..., M, K]
    W: [Batch..., K, N]
    A: [Batch..., K, R]
    B: [Batch..., R, N]

    (outer: dot X (add W (inner: dot A B)))
    =>
    (add (dot[outer.attrs] X W) (dot[inner.attrs] (dot[outer.attrs] X A) B))

    where {
        outer.attrs.rhs_batching_dimensions == inner.axes.B.positions
        && outer.attrs.rhs_contracting_dimensions == inner.axes.I.positions
    }
}
