abstract rule commute(F: op<(tensor, tensor) -> tensor>) {
    (F X Y) => (F Y X)
}

// Instantiate with operations whose semantics permit reassociation.
abstract rule associate_right(F: op<(tensor, tensor) -> tensor>) {
    (F (F X Y) Z) => (F X (F Y Z))
}

// Relationships between multiple operations use multiple op parameters.
abstract rule distribute_left(
    product: op<(tensor, tensor) -> tensor>,
    sum: op<(tensor, tensor) -> tensor>
) {
    (product X (sum Y Z)) => (sum (product X Y) (product X Z))
}
