from "../dialects/tensor.tepl" import TensorLang as t;

// Explicitly compose two permutations. The spread preserves other fields if
// the schema later grows; the explicit field replaces the copied permutation.
rule compose_transposes {
    X: [Dims...]
    (t.transpose[@outer] (t.transpose[@inner] X))
    =>
    (t.transpose[@combined] X)

    where {
        let rank = len(Dims);
        is_valid_axis_list(@outer.permutation, rank);
        is_valid_axis_list(@inner.permutation, rank);
        len(@outer.permutation) == rank;
        len(@inner.permutation) == rank;
    }
    derive {
        let permutation = gather(@inner.permutation, @outer.permutation);
        @combined = { ..@outer, permutation: permutation };
    }
}

// Lists, indexing, conditionals, and comprehensions are available in rules.
rule remove_identity_transpose {
    X: [Dims...]
    (t.transpose[@p] X) => X
    where {
        let axes = range(len(Dims));
        len(@p.permutation) == len(Dims);
        all([@p.permutation[i] == i for i in axes]);
    }
}

// A constructor without a spread gets its schema from the RHS operation.
rule compose_transposes_explicit {
    (t.transpose[@outer] (t.transpose[@inner] X))
    => (t.transpose[@combined] X)
    derive {
        @combined = {
            permutation: if len(@outer.permutation) == 0
                then []
                else gather(@inner.permutation, @outer.permutation)
        };
    }
}
