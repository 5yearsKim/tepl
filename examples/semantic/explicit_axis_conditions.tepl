from "dialects/tensor.tepl" import TensorLang as t;
use t::{dot, transpose};

// Explicit feasibility constraints: no --infer-applicability flag is needed.
// Compile with --semantic-policy=algebraic. The compiler command
// check --infer-applicability emits a complete rule with symbolic node labels.
rule remove_output_permutation {
    (source: transpose (dot A B)) => (result: dot A B)
    where {
        let wanted = source.axes.order;
        let batches = filter(wanted, result.axes.B.members);
        let fromA = filter(wanted, result.axes.I.members);
        let fromB = filter(wanted, result.axes.J.members);
        axis_domain()
        && subsequence(fromA, A.axes.order)
        && subsequence(fromB, B.axes.order)
        && wanted == concat(batches, fromA, fromB)
    }
}

graph feasible {
    input A: f32[2];
    input B: f32[2];
    let product = (dot[lhs_contracting_dimensions=[], rhs_contracting_dimensions=[],
                       lhs_batching_dimensions=[], rhs_batching_dimensions=[]] A B);
    yield (transpose[permutation=[0,1]] product);
}

graph infeasible {
    input A: f32[2];
    input B: f32[2];
    let product = (dot[lhs_contracting_dimensions=[], rhs_contracting_dimensions=[],
                       lhs_batching_dimensions=[], rhs_batching_dimensions=[]] A B);
    yield (transpose[permutation=[1,0]] product);
}
