from "dialects/tensor.tepl" import TensorLang as t
use t::{dot, transpose}

// A sufficient source restriction is explicit; the compiler proves it covers
// every legal match. No runtime inference/domain guard is added.
rule remove_output_permutation {
  (source: transpose (dot A B)) => (result: dot A B)

  where source.attrs.permutation == range(len(source.attrs.permutation))
}

graph feasible {
  input A: f32[2]
  input B: f32[2]

  let product =
    (dot[
      lhs_contracting_dimensions = [],
      rhs_contracting_dimensions = [],
      lhs_batching_dimensions = [],
      rhs_batching_dimensions = []
    ]
      A
      B)

  yield (transpose[permutation = [0, 1]] product)
}

graph infeasible {
  input A: f32[2]
  input B: f32[2]

  let product =
    (dot[
      lhs_contracting_dimensions = [],
      rhs_contracting_dimensions = [],
      lhs_batching_dimensions = [],
      rhs_batching_dimensions = []
    ]
      A
      B)

  yield (transpose[permutation = [1, 0]] product)
}
