from "dialects/tensor.tepl" import TensorLang as t;
use t::{slice, add, transpose};

rule slice_add {
  (s: slice (add A B)) => (add (slice A) (slice B))
}

rule compose_slice {
  (outer: slice (inner: slice A)) => (slice A)
}

rule slice_transposed_input {
  (s: slice (p: transpose (add A B)))
  => (add (slice (transpose[p.attrs] A)) (slice (transpose[p.attrs] B)))
}
