from "../dialects/tensor.tepl" import TensorLang as t;
use t::{add, mul, negate, subtract, zero_like, transpose, reduce_sum, dot};

rule negate_twice {
    (negate (negate A)) => A
}

rule subtract_self {
    (subtract A A) => (zero_like A)
}

rule subtract_negated {
    (subtract A (negate B)) => (add A B)
}

rule zero_product {
    (mul A (zero_like A)) => (zero_like A)
}

rule combine_repeated_terms {
    (add (mul A A) (mul A A)) => (mul (add A A) A)
}

rule transpose_negate {
    (transpose[@p] (negate A)) => (negate (transpose[auto] A))
}

rule reduce_negate {
    (reduce_sum[@r] (negate A)) => (negate (reduce_sum[auto] A))
}

rule dot_negate {
    (dot[@d] (negate A) B) => (negate (dot[auto] A B))
}
