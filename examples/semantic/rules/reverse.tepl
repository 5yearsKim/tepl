from "dialects/tensor.tepl" import TensorLang as t;
use t::{reverse, add, mul, broadcast};

rule reverse_twice {
    (reverse[@outer] (reverse[@inner] A)) => A
    where { @outer.dimensions == @inner.dimensions }
}

rule reverse_empty_axes {
    (reverse[@r] A) => A
    where { @r.dimensions == [] }
}

rule reverse_add {
    (reverse[@r] (add A B)) => (add (reverse[@r] A) (reverse[@r] B))
}

rule reverse_multiply {
    (reverse[@r] (mul A B)) => (mul (reverse[@r] A) (reverse[@r] B))
}

rule reverse_scalar_broadcast {
    (reverse[@r] (broadcast[@b] C)) => (broadcast[@b] C)
    where { @b.dimensions == [] }
}

// Applying reverse_add or reverse_multiply followed by
// reverse_scalar_broadcast leaves a broadcast scalar unchanged.
