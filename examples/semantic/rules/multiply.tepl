from "dialects/tensor.tepl" import TensorLang as t;
use t::{add, mul, transpose};

rule multiply_associate {
    (mul (mul A B) C) => (mul A (mul B C))
}

rule multiply_distribute {
    (mul (add A B) C) => (add (mul A C) (mul B C))
}

rule multiply_factor {
    (add (mul A C) (mul B C)) => (mul (add A B) C)
}

rule transpose_multiply {
    (transpose[@p] (mul A B))
    => (mul (transpose[auto] A) (transpose[auto] B))
}
