from "dialects/tensor.tepl" import TensorLang as t;
use t::{transpose, dot, add};

rule copy_descriptor {
    (p: transpose X) => (copy: transpose X)
    derive { copy.attrs = { ..p.attrs }; }
}

rule distribute_constructor {
    (d: dot (add A B) C)
    => (add (left: dot A C) (right: dot B C))
    derive {
        left.attrs = { ..d.attrs };
        right.attrs = { ..left.attrs };
    }
}

// The explicit constructor implements the same transformation that auto can
// synthesize. Both pass through the independent semantic verifier.
rule compose_transposes {
    (outer: transpose (inner: transpose X))
    => (combined: transpose X)
    derive {
        let permutation = gather(inner.attrs.permutation, outer.attrs.permutation);
        combined.attrs = { ..outer.attrs, permutation: permutation };
    }
}
