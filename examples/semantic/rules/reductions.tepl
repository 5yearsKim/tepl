from "dialects/tensor.tepl" import TensorLang as t;
use t::{add, reduce_sum, transpose};

// Exact-arithmetic reduction linearity; axes and domains are matched jointly.
rule sum_distribute {
    (reduce_sum (add A B))
    =>
    (add (reduce_sum A) (reduce_sum B))
}

// Permutations compose through ordered interfaces, with no arithmetic rewrite.
rule transpose_compose {
    (transpose (transpose A))
    =>
    (transpose A)
}

rule merge_reductions {
    (reduce_sum[@outer] (reduce_sum[@inner] A))
    => (reduce_sum[auto] A)
}

// A corrective output transpose preserves the order of the retained axes.
rule transpose_reduce {
    (reduce_sum[@r] (transpose[@p] A))
    => (transpose[auto] (reduce_sum[auto] A))
}
