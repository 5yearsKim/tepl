from "dialects/tensor.tepl" import TensorLang as t;
use t::{add};

// Literal operands match exact spelling; X captures any tensor expression.
// As with simple.tepl, these examples assume addition can be commuted.
rule commute_integer_literal {
    (add X 1) => (add 1 X)
}

rule commute_float_literal {
    (add X 1.0) => (add 1.0 X)
}

rule commute_negative_literal {
    (add X -0.5) => (add -0.5 X)
}
