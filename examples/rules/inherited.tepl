from "abstract.tepl" import {commute, associate_right, distribute_left};
from "../dialects/tensor.tepl" import TensorLang as t;

// These instances assume swapping operands is valid in the target semantics.
rule commute_add extends commute(F = t.add);
rule commute_mul extends commute(F = t.multiply);

// A concrete rule can add restrictions while inheriting the graph pattern.
// X and Y refer to the variables declared by the abstract pattern.
rule commute_small_vectors extends commute(F = t.add) {
    X: [N]
    Y: [N]

    where {
        N <= 1024;
    }
}

// The host checks must account for shapes and numerical semantics, including
// whether floating-point reassociation is permitted. They are placeholders
// for host implementations, not built-in functions.
rule associate_add_right extends associate_right(
    F = t.add,
    allowed = can_reassociate_add
);

rule associate_mul_right extends associate_right(
    F = t.multiply,
    allowed = can_reassociate_mul
);

// Added conditions are combined with the inherited allowed(X, Y, Z) check.
// The child cannot remove that check or replace the inherited graph pattern.
rule associate_small_vectors extends associate_right(
    F = t.add,
    allowed = can_reassociate_add
) {
    X: [N]
    Y: [N]
    Z: [N]

    where {
        N <= 1024;
    }
}

// This host check must establish that distribution preserves the required
// shape and numerical semantics for the matched inputs.
rule distribute_mul_over_add extends distribute_left(
    product = t.multiply,
    sum = t.add,
    allowed = can_distribute_mul_over_add
);
