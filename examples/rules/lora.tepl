from "../dialects/tensor.tepl" import TensorLang as t;
use t::{add, dot};

rule lora {
    X: [Batch..., M, K]
    W: [WeightBatch..., K, N]
    A: [WeightBatch..., K, R]
    B: [WeightBatch..., R, N]

    (dot[@outer] X
      (add W
        (dot[@inner] A B)))
    =>
    (add
      (dot[@xw] X W)
      (dot[@out]
        (dot[@xa] X A)
        B))

    where {
        $is_broadcastable(Batch, WeightBatch);
        $is_reassociable(X, A, B, @outer, @inner);
    }

    derive {
        @xw  = $infer_dot(X, W, @outer);
        @xa  = $infer_dot(X, A, @outer);
        @out = $infer_lora_out(X, A, B, @outer, @inner);
    }
}
