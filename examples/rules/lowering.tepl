from "../dialects/tensor.tepl" import TensorLang as t;
from "../dialects/scalar.tepl" import Scalar as s;

// Only rank-zero tensors may cross to the scalar dialect.
// No dtype annotation means any dtype; output inference checks compatibility.
rule scalar_add {
    X: []
    Y: []

    (t.add X Y) => (s.add X Y)
}
