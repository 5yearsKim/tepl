rule shape_constraints {
    X: [..., M, K]
    W: [K, N]
    B: [N]
    Y: [M, Batch..., K]
    Z: [M, K, Tail...]
    T: [_, N]
    S: scalar
    U: []

    (tuple X W B Y Z T S U) => (tuple X W B Y Z T S U)

    where {
        rank(X) >= 2;
        K % 128 == 0;
        M + 2 * N <= K && !(N == 0) || false;
        broadcastable(Batch, Tail);
    }
}
