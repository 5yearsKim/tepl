from "../dialects/my_dialect.tepl" import MyDialect as d

rule associate_add {
  (d.add (d.add X Y) Z) => (d.add X (d.add Y Z))
}

rule swap_add {
  (d.add X Y) => (d.add Y X)
}

rule swap_dot {
  (dot: d.dot X Y) => (d.dot[dot.attrs] Y X)

  where dot.attrs.axis == 0
}

abstract rule factor_dot() {
  dtype T
  X: T[M, K]
  Y: T[K, N]
  Z: T[K, N]

  (d.add (left: d.dot X Y) (right: d.dot X Z))
  =>
  (d.dot[left.attrs] X (d.add Y Z))

  where left.attrs.axis == right.attrs.axis
}

// Inherit the pattern, dtype/shape bindings, and axis check; add a limit.
rule factor_small_dot extends factor_dot() {
  where K <= 8
}
