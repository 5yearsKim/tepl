from "dialects/hlo.tepl" import HLO as hlo;

// Catalog: reduction-slice-window-to-reduce
// Scope: Last element of a rank-one full cumulative window; f32 sum.
// Source arithmetic/applicability conditions are recorded in the manifest.
rule catalog_reduction_slice_window_to_reduce {
    X: f32[N]
     (attr_s: hlo.slice (attr_w: hlo.reduce_window_sum X 0.0:f32)) => (attr_out: hlo.reshape (attr_r: hlo.reduce_sum X))
     where { N>0 && attr_w.attrs.window_dimensions==[N] && attr_w.attrs.window_strides==[1] && attr_w.attrs.base_dilations==[1] && attr_w.attrs.window_dilations==[1] && attr_w.attrs.padding_low==[N-1] && attr_w.attrs.padding_high==[0] && attr_s.attrs.starts==[N-1] && attr_s.attrs.sizes==[1] && attr_s.attrs.strides==[1] }
     derive { attr_r.attrs={dimensions:[0]}; attr_out.attrs={shape:[1]}; }
}
