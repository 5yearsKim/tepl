from "dialects/hlo.tepl" import HLO as hlo;

// Catalog: reduction-window-singleton-add
// Scope: Unit windows and nonnegative edge padding; scalar initializer preserved.
// Source arithmetic/applicability conditions are recorded in the manifest.
rule catalog_reduction_window_singleton_add {
    X: [Dims...] Init: []
     (hlo.reduce_window_sum[@w] X Init) => (hlo.nonnegative_pad[@p] (hlo.add X (hlo.broadcast[@b] Init)) Init)
     where { @w.window_dimensions==[1 for d in Dims] && @w.window_strides==[1 for d in Dims] && @w.base_dilations==[1 for d in Dims] && @w.window_dilations==[1 for d in Dims] }
     derive { @b={dimensions:[],new_extents:Dims}; @p={low:@w.padding_low,high:@w.padding_high,interior:[0 for d in Dims]}; }
}
