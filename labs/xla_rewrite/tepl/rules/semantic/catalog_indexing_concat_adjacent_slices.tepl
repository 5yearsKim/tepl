from "dialects/hlo.tepl" import HLO as hlo;

// Catalog: indexing-concat-adjacent-slices
// Scope: Adjacent rank-one unit-stride slices.
// Source arithmetic/applicability conditions are recorded in the manifest.
rule catalog_indexing_concat_adjacent_slices {
    (hlo.concatenate[@c] (hlo.slice[@a] X) (hlo.slice[@b] X)) => (hlo.slice[@out] X)
     where { @c.dimension==0 && @a.strides==[1] && @b.strides==[1] && @a.starts[0]+@a.sizes[0]==@b.starts[0] }
     derive { @out={starts:@a.starts,sizes:[@a.sizes[0]+@b.sizes[0]],strides:[1]}; }
}
