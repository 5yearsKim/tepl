from "dialects/hlo.tepl" import HLO as hlo;

// Catalog: broadcast-multiply-constant-into-broadcast
// Scope: Scalar factor C is a captured scalar; literal-only profitability does not affect the identity.
// Source arithmetic/applicability conditions are recorded in the manifest.
rule catalog_broadcast_multiply_constant_into_broadcast {
    Y: [Dims...] C: []
     (hlo.multiply (hlo.multiply X (attr_out: hlo.broadcast C)) (attr_b: hlo.broadcast Y))
     => (hlo.multiply X (hlo.broadcast[attr_b.attrs] (hlo.multiply Y (attr_base: hlo.broadcast C))))
     where { attr_out.attrs.dimensions == [] }
     derive { attr_base.attrs = { dimensions: [], new_extents: Dims }; }
}
