from "dialects/hlo.tepl" import HLO as hlo;

// Catalog: elementwise-imag-noncomplex
// Scope: Noncomplex f32 inputs of arbitrary rank.
// Source arithmetic/applicability conditions are recorded in the manifest.
rule catalog_elementwise_imag_noncomplex {
    X: f32[Dims...] (hlo.imag X) => (hlo.zero_like X)
}
