from "dialects/hlo.tepl" import HLO as hlo;

// Catalog: dot-move-contracting-permutation
// Scope: Swap two contraction subdimensions before flattening; rank-three left operand.
// Source arithmetic/applicability conditions are recorded in the manifest.
rule catalog_dot_move_contracting_permutation {
    X: [M,A,B] C: [AB,N]
     (hlo.dot[@d] (hlo.reshape[@r] (hlo.transpose[@p] X)) C)
     => (hlo.dot[@d] (hlo.reshape[@r] X) (hlo.reshape[@flat] (hlo.transpose[@q] (hlo.reshape[@split] C))))
     where { AB==A*B && @p.permutation==[0,2,1] && @r.shape==[M,A*B] && @d.lhs_batching_dimensions==[] && @d.rhs_batching_dimensions==[] && @d.lhs_contracting_dimensions==[1] && @d.rhs_contracting_dimensions==[0] }
     derive { @split={shape:[B,A,N]}; @q={permutation:[1,0,2]}; @flat={shape:[A*B,N]}; }
}
