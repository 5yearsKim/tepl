from "dialects/hlo.tepl" import HLO as hlo;

// Catalog: reduction-empty
// Scope: Single-output reduction with arbitrary initial value and empty input.
// Source arithmetic/applicability conditions are recorded in the manifest.
rule catalog_reduction_empty {
    X: [Dims...] Init: []
     (attr_r: hlo.reduce X Init) => (attr_b: hlo.broadcast Init)
     where { product(Dims)==0 }
     derive { attr_b.attrs={dimensions:[],new_extents:gather(Dims,exclude(range(len(Dims)),attr_r.attrs.dimensions))}; }
}
