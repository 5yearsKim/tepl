from "dialects/hlo.tepl" import HLO as hlo;

// Catalog: indexing-gather-pad
// Scope: Rank-two gather over rows; edge padding only on the passthrough column axis.
// Source arithmetic/applicability conditions are recorded in the manifest.
rule catalog_indexing_gather_pad {
    X: [R,C] Indices: [I]
     (hlo.gather[@g] (hlo.nonnegative_pad[@p] X Value) Indices) => (hlo.nonnegative_pad[@p] (hlo.gather[@out] X Indices) Value)
     where { @p.low[0]==0 && @p.high[0]==0 && @p.interior==[0,0] && @g.start_index_map==[0] && @g.collapsed_slice_dims==[0] && @g.offset_dims==[1] && @g.index_vector_dim==1 && @g.slice_sizes==[1,C+@p.low[1]+@p.high[1]] && @g.operand_batching_dims==[] && @g.start_indices_batching_dims==[] }
     derive { @out={..@g,slice_sizes:[1,C],shape:[I,C]}; }
}
