from "dialects/hlo.tepl" import HLO as hlo;

// Catalog: convolution-swap-operands
// Scope: One spatial axis, unit strides/dilations, nonnegative transformed padding; kernel reversal, role swap and precision swap are explicit.
// Source arithmetic/applicability conditions are recorded in the manifest.
rule catalog_convolution_swap_operands {
    X: [N,L,C] W: [K,C,F]
     (attr_c: hlo.general_convolution X W) => (attr_out: hlo.general_convolution (attr_rev: hlo.reverse W) X)
     where { L>0 && K>L && attr_c.attrs.padding_low[0]+L>=K && attr_c.attrs.padding_high[0]+L>=K && attr_c.attrs.feature_group_count==1 && attr_c.attrs.batch_group_count==1 && attr_c.attrs.window_strides==[1] && attr_c.attrs.lhs_dilation==[1] && attr_c.attrs.rhs_dilation==[1] && attr_c.attrs.window_reversal==[false] && len(attr_c.attrs.precision_config)==2 && attr_c.attrs.input_batch_dimension==0 && attr_c.attrs.input_feature_dimension==2 && attr_c.attrs.input_spatial_dimensions==[1] && attr_c.attrs.kernel_input_feature_dimension==1 && attr_c.attrs.kernel_output_feature_dimension==2 && attr_c.attrs.kernel_spatial_dimensions==[0] && attr_c.attrs.output_batch_dimension==0 && attr_c.attrs.output_feature_dimension==2 && attr_c.attrs.output_spatial_dimensions==[1] }
     derive { attr_rev.attrs={dimensions:[0]}; attr_out.attrs={..attr_c.attrs,padding_low:[L+attr_c.attrs.padding_low[0]-K],padding_high:[L+attr_c.attrs.padding_high[0]-K],window_reversal:[true],input_batch_dimension:2,input_feature_dimension:1,input_spatial_dimensions:[0],kernel_input_feature_dimension:2,kernel_output_feature_dimension:0,kernel_spatial_dimensions:[1],output_batch_dimension:2,output_feature_dimension:0,output_spatial_dimensions:[1],precision_config:gather(attr_c.attrs.precision_config,[1,0])}; }
}
