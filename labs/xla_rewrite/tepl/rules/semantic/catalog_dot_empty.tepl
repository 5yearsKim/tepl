from "dialects/hlo.tepl" import HLO as hlo;

// Catalog: dot-empty
// Scope: Arbitrary tensor shapes under the catalog arithmetic/applicability assumptions.
// Source arithmetic/applicability conditions are recorded in the manifest.
rule catalog_dot_empty {
    dtype T; X: T[Left...] Y: T[Right...]
     (hlo.dot[@d] X Y) => (hlo.fill[@z])
     where { product(Left)==0 || product(Right)==0 }
     derive { let lf=exclude(range(len(Left)),concat(@d.lhs_batching_dimensions,@d.lhs_contracting_dimensions)); let rf=exclude(range(len(Right)),concat(@d.rhs_batching_dimensions,@d.rhs_contracting_dimensions)); @z={shape:concat(gather(Left,@d.lhs_batching_dimensions),gather(Left,lf),gather(Right,rf)),value:0,element_type:T}; }
}
