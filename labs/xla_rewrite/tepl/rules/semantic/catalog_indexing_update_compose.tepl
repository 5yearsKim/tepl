from "dialects/hlo.tepl" import HLO as hlo;

// Catalog: indexing-update-compose
// Scope: Rank-one scalar i64 starts; explicit independently clamped composition.
// Source arithmetic/applicability conditions are recorded in the manifest.
rule catalog_indexing_update_compose {
    X: [N] Y: [M] S: i64[] T: i64[]
     (hlo.dynamic_update_slice X (hlo.dynamic_update_slice (hlo.dynamic_slice[@s] X S) Y T) S)
     => (hlo.dynamic_update_slice X Y (hlo.add (hlo.clamp 0:i64 S (hlo.scalar[@first])) (hlo.clamp 0:i64 T (hlo.scalar[@second]))))
     derive { @first={value:N-@s.sizes[0],element_type:i64,shape:[]}; @second={value:@s.sizes[0]-M,element_type:i64,shape:[]}; }
}
