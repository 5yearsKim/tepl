from "dialects/hlo_structural.tepl" import HLO as hlo;

// Catalog: transpose-reshape-reshape-transpose-cancel-chain
// Scope: A reshape/transpose/reshape chain moving a single unit axis.
// Source arithmetic/applicability conditions are recorded in the manifest.
rule catalog_transpose_reshape_reshape_transpose_cancel_chain {
    X: [N]
     (hlo.reshape[@outer] (hlo.transpose[@p] (hlo.reshape[@inner] X))) => X
     where { @inner.shape==[1,N] && @p.permutation==[1,0] && @outer.shape==[N] }
}
