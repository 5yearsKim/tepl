from "dialects/hlo_structural.tepl" import HLO as hlo;

// Catalog: elementwise-divide-converted-predicate
// Scope: Written operand/opcode variant under the catalog conditions.
// Source arithmetic/applicability conditions are recorded in the manifest.
rule catalog_elementwise_divide_converted_predicate {
    P: [Dims...] Y: []
     (hlo.divide (hlo.convert[@c] P) (hlo.broadcast[@b] Y))
     => (hlo.multiply (hlo.broadcast[@b] (hlo.divide 1 Y)) (hlo.convert[@c] P))
     where { @b.dimensions == [] }
}
