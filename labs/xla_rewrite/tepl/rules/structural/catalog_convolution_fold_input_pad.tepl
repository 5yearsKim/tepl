from "dialects/hlo_structural.tepl" import HLO as hlo;

// Catalog: convolution-fold-input-pad
// Scope: One canonical spatial axis; no existing input dilation or convolution edge padding.
// Source arithmetic/applicability conditions are recorded in the manifest.
rule catalog_convolution_fold_input_pad {
    X: [N,L,C]
     (hlo.general_convolution[@c] (hlo.nonnegative_pad[@p] X 0) W) => (hlo.general_convolution[@out] X W)
     where { @c.input_batch_dimension==0 && @c.input_feature_dimension==2 && @c.input_spatial_dimensions==[1] && @c.kernel_input_feature_dimension==1 && @c.kernel_output_feature_dimension==2 && @c.kernel_spatial_dimensions==[0] && @c.output_batch_dimension==0 && @c.output_feature_dimension==2 && @c.output_spatial_dimensions==[1] && @p.low[0]==0 && @p.low[2]==0 && @p.high[0]==0 && @p.high[2]==0 && @p.interior[0]==0 && @p.interior[2]==0 && @c.lhs_dilation==[1] && @c.padding_low==[0] && @c.padding_high==[0] }
     derive { @out={..@c,padding_low:[@p.low[1]],padding_high:[@p.high[1]],lhs_dilation:[@p.interior[1]+1]}; }
}
