from "dialects/hlo_structural.tepl" import HLO as hlo;

// Catalog: reduction-window-to-reduce
// Scope: Arbitrary-rank f32 zero-initialized sum windows, each axis unit or full.
// Source arithmetic/applicability conditions are recorded in the manifest.
rule catalog_reduction_window_to_reduce {
    X: f32[Dims...]
     (hlo.reduce_window_sum[@w] X 0.0:f32) => (hlo.reshape[@shape] (hlo.reduce_sum[@r] X))
     where { @w.window_strides==[1 for d in Dims] && @w.base_dilations==[1 for d in Dims] && @w.window_dilations==[1 for d in Dims] && @w.padding_low==[0 for d in Dims] && @w.padding_high==[0 for d in Dims] && all([@w.window_dimensions[i]==1 || @w.window_dimensions[i]==Dims[i] for i in range(len(Dims))]) }
     derive { @r={dimensions:exclude(range(len(Dims)),[if @w.window_dimensions[i]==1 then i else len(Dims) for i in range(len(Dims))])}; @shape={shape:[if @w.window_dimensions[i]==1 then Dims[i] else 1 for i in range(len(Dims))]}; }
}
