from "dialects/hlo_structural.tepl" import HLO as hlo;

// Catalog: broadcast-slice-broadcast
// Scope: Arbitrary tensor shapes under the catalog arithmetic/applicability assumptions.
// Source arithmetic/applicability conditions are recorded in the manifest.
rule catalog_broadcast_slice_broadcast {
    X: [Dims...]
     (hlo.slice[@s] (hlo.broadcast[@b] X)) => (hlo.broadcast[@out] (hlo.slice[@inner] X))
     derive { @inner = { starts:gather(@s.starts,@b.dimensions), sizes:gather(@s.sizes,@b.dimensions), strides:gather(@s.strides,@b.dimensions) };
      @out = { ..@b, new_extents:gather(@s.sizes,exclude(range(len(@s.sizes)),@b.dimensions)) }; }
}
