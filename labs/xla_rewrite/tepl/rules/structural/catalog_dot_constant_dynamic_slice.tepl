from "dialects/hlo_structural.tepl" import HLO as hlo;

// Catalog: dot-constant-dynamic-slice
// Scope: Rank-two dot with one selected left free-axis element. Captured C/D may be constants; the identity also holds for nonconstants.
// Source arithmetic/applicability conditions are recorded in the manifest.
rule catalog_dot_constant_dynamic_slice {
    C: [M,K] D: [K,N] S0: i32[] S1: i32[]
     (hlo.dot[@d] (hlo.dynamic_slice[@s] C S0 S1) D) => (hlo.dynamic_slice[@out] (hlo.dot[@d] C D) S0 0:i32)
     where { @s.sizes==[1,K] && @d.lhs_batching_dimensions==[] && @d.rhs_batching_dimensions==[] && @d.lhs_contracting_dimensions==[1] && @d.rhs_contracting_dimensions==[0] }
     derive { @out={sizes:[1,N]}; }
}
