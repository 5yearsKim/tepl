from "dialects/hlo_structural.tepl" import HLO as hlo;

// Catalog: indexing-select-update
// Scope: Rank-one base, predicate and update; one scalar start.
// Source arithmetic/applicability conditions are recorded in the manifest.
rule catalog_indexing_select_update {
    P: [N] X: [N] Y: [M]
     (hlo.select P X (hlo.dynamic_update_slice X Y S))
     => (hlo.dynamic_update_slice X (hlo.select (hlo.dynamic_slice[@slice] P S) (hlo.dynamic_slice[@slice] X S) Y) S)
     derive { @slice={sizes:[M]}; }
}
