from "dialects/hlo_structural.tepl" import HLO as hlo;

// Catalog: reduction-reshape-free
// Scope: Rank-three input; sum over first axis while reshape merges free axes.
// Source arithmetic/applicability conditions are recorded in the manifest.
rule catalog_reduction_reshape_free {
    X: [A,B,C]
     (hlo.reduce_sum[@r] (hlo.reshape[@s] X)) => (hlo.reshape[@out] (hlo.reduce_sum[@r] X))
     where { @s.shape==[A,B*C] && @r.dimensions==[0] }
     derive { @out={shape:[B*C]}; }
}
