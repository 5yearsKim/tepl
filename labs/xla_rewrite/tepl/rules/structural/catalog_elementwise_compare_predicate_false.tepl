from "dialects/hlo_structural.tepl" import HLO as hlo;

// Catalog: elementwise-compare-predicate-false
// Scope: Scalar literal instance; source conditions retained in the catalog.
// Source arithmetic/applicability conditions are recorded in the manifest.
rule catalog_elementwise_compare_predicate_false {
    X: bool[] (hlo.compare[@c] X 0:bool) => X where { @c.direction == 1 }
}
