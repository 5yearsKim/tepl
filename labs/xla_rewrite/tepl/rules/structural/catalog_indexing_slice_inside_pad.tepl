from "dialects/hlo_structural.tepl" import HLO as hlo;

// Catalog: indexing-slice-inside-pad
// Scope: Arbitrary tensor shapes under the catalog arithmetic/applicability assumptions.
// Source arithmetic/applicability conditions are recorded in the manifest.
rule catalog_indexing_slice_inside_pad {
    X: [Dims...]
     (hlo.slice[@s] (hlo.nonnegative_pad[@p] X C)) => (hlo.slice[@out] X)
     where { @s.strides==[1 for d in Dims] && @p.interior==[0 for d in Dims] && all([@s.starts[i]>=@p.low[i] && @s.starts[i]+@s.sizes[i]<=@p.low[i]+Dims[i] for i in range(len(Dims))]) }
     derive { @out={..@s,starts:[@s.starts[i]-@p.low[i] for i in range(len(Dims))]}; }
}
