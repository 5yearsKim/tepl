// Generated inference variant; original graph and conditions preserved.
from "dialects/hlo.tepl" import HLO as hlo;
use hlo::{dot, reduce_sum};

rule dot_reduce_batch {
    X: [K]
    Y: [K]
    (attr_r: reduce_sum (attr_d: dot X Y)) => (attr_out: dot X Y)
    where { attr_d.attrs.lhs_batching_dimensions == [0] && attr_d.attrs.rhs_batching_dimensions == [0]
         && attr_d.attrs.lhs_contracting_dimensions == []
         && attr_d.attrs.rhs_contracting_dimensions == [] && attr_r.attrs.dimensions == [0] }
    
}
