// Generated inference variant; original graph and conditions preserved.
from "dialects/hlo.tepl" import HLO as hlo;

// Expression check under the source conditions recorded in the catalog.
rule expr_slice_compose_general {
    (attr_outer: hlo.slice (attr_inner: hlo.slice X)) => (attr_out: hlo.slice X) where { attr_inner.attrs.strides == [1 for s in attr_inner.attrs.strides] && attr_outer.attrs.strides == [1 for s in attr_outer.attrs.strides] } 
}
