rule AS_5389 {
  A: [ADims...]
  (c: candidate A B C D) => (r: reference)
  where c.attrs.site == 5389
  derive {
    r.attrs = {shape: c.attrs.shape, type: c.attrs.type, id: c.attrs.ids[c.attrs.index]}
  }
}

