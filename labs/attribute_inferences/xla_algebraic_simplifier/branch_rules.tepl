from "./branch_dialect.tepl" import Branch as h
use h::{candidate,add,multiply,divide,negate,reshape,broadcast,scalar,iota,reference,first_scalar,reciprocal_literal,clone1,clone2,clone3,dot,transpose,convert,reduce,convolution,coordinate_sum}

rule AS_934 {
  A: [ADims...]
  (c: candidate A B C D) => (add B A)
  where c.attrs.site == 934
}

rule AS_1405 {
  A: [ADims...]
  (c: candidate A B C D) => B
  where c.attrs.site == 1405
}

