  (c: candidate A B C D) => (r: iota)
  where c.attrs.site == 2317
  derive {
    r.attrs = {shape: c.attrs.shape, type: c.attrs.type, dimension: 0}
  }
}

rule AS_2311 {
  A: [ADims...]
  (c: candidate A B C D) => (r: broadcast (first_scalar A))
  where c.attrs.site == 2311
  derive {
    r.attrs = {shape: c.attrs.shape, dimensions: [], enabled: true}
  }
}

rule AS_5690 {
  A: [ADims...]
  (c: candidate A B C D) => (r: iota)
  where c.attrs.site == 5690
  derive {
    r.attrs = {shape: c.attrs.shape, type: c.attrs.type, dimension: c.attrs.a[c.attrs.b[0]]}
  }
}

rule AS_5723 {
  A: [ADims...]
  (c: candidate A B C D) => (r: broadcast (s: reshape A))
  where c.attrs.site == 5723
  derive {
    let keep = exclude([if ADims[i] == 1 then len(ADims) else i for i in range(len(ADims))], [len(ADims)])
    s.attrs = {shape: gather(ADims, keep), enabled: len(keep) != len(ADims)}
    r.attrs = {shape: c.attrs.shape, dimensions: gather(c.attrs.a, keep), enabled: true}
  }
}

rule AS_2824 {
  A: [ADims...]
  (c: candidate A B C D) => (r: broadcast A)
  where c.attrs.site == 2824
  derive {
    let inv = [sum([if c.attrs.b[j] == i then j else 0 for j in range(len(c.attrs.b))]) for i in range(len(c.attrs.b))]
    r.attrs = {shape: c.attrs.shape, dimensions: gather(inv, c.attrs.a), enabled: true}
  }
}

rule AS_5132 {
  A: [ADims...]
  B: [BDims...]
  C: [CDims...]
  (c: candidate A B C D) => (multiply A (r: broadcast (multiply B C)))
  where c.attrs.site == 5132
  derive {
    r.attrs = {shape: c.attrs.shape, dimensions: [], enabled: len(BDims) == 0 && len(c.attrs.shape) != 0}
  }
}

rule AS_5165 {
  A: [ADims...]
  B: [BDims...]
  C: [CDims...]
  (c: candidate A B C D) => (multiply A (r: broadcast (multiply B (v: broadcast C))))
  where c.attrs.site == 5165
  derive {
    v.attrs = {shape: BDims, dimensions: [], enabled: len(BDims) != 0}
    r.attrs = {shape: c.attrs.shape, dimensions: c.attrs.a, enabled: true}
  }
}

rule AS_2614 {
  A: [ADims...]
  B: [BDims...]
  C: [CDims...]
  (c: candidate A B C D) => (multiply A (r: broadcast (divide (v: scalar) B)))
  where c.attrs.site == 2614
  derive {
    v.attrs = {shape: BDims, type: c.attrs.type, value: i64(1)}
    r.attrs = {shape: c.attrs.shape, dimensions: c.attrs.a, enabled: true}
  }
}

rule AS_2590 {
  A: [ADims...]
  B: [BDims...]
  C: [CDims...]
  (c: candidate A B C D) => (multiply A (r: broadcast (reciprocal_literal B)))
  where c.attrs.site == 2590
  derive {
    r.attrs = {shape: CDims, dimensions: c.attrs.a, enabled: c.attrs.index == 1}
  }
}

