load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

cc_binary(
    name = "inference_benchmark",
    srcs = ["inference_benchmark.cc"],
    deps = [
        "//src/core:pipeline",
        "//src/core/resolution",
        "//src/core/checking",
        "//src/core/semantics",
        "//src/core/lowering",
        "//src/executable",
        "//src/inference",
        "//src/rewrite",
        "//src/core/syntax:syntax",
        "@nlohmann_json//:json",
    ],
)

cc_test(
    name = "timing_test",
    srcs = ["timing_test.cc"],
    args = ["$(rootpath //tests/fixtures:semantic/dialects/tensor.tepl)"],
    data = ["//tests/fixtures:semantic/dialects/tensor.tepl"],
    deps = ["//src/core:pipeline", "//src/inference"],
)
