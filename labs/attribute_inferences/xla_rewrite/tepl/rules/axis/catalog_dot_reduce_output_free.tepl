// Canonical axis-only evaluation task; no descriptor or non-axis inference.
from "dialects/hlo.tepl" import HLO as hlo;

// Catalog: dot-reduce-output-free
// Scope: Reduce the left free axis of a rank-two dot; implicit sum initializer zero.
// Source arithmetic/applicability conditions are recorded in the manifest.
rule catalog_dot_reduce_output_free {
    X: [M,K] Y: [K,N]
     (attr_r: hlo.reduce_sum (attr_d: hlo.dot X Y)) => (attr_out: hlo.dot (axis_eval_0: hlo.reduce_sum X) Y)
     where { attr_r.attrs.dimensions==[0] && attr_d.attrs.lhs_batching_dimensions==[] && attr_d.attrs.rhs_batching_dimensions==[] && attr_d.attrs.lhs_contracting_dimensions==[1] && attr_d.attrs.rhs_contracting_dimensions==[0] }
     
derive {
 axis_eval_0.attrs = {dimensions: auto};
 attr_out.attrs = {lhs_contracting_dimensions: auto, rhs_contracting_dimensions: auto, lhs_batching_dimensions: auto, rhs_batching_dimensions: auto};
}
}
