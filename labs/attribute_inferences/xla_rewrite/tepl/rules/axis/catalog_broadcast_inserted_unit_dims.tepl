// Canonical axis-only evaluation task; no descriptor or non-axis inference.
from "dialects/axis_views.tepl" import AxisViews as axis_view;
from "dialects/hlo.tepl" import HLO as hlo;

// Catalog: broadcast-inserted-unit-dims
// Scope: Rank-one X; reshape inserts a leading unit axis; the outer broadcast appends axes.
// Source arithmetic/applicability conditions are recorded in the manifest.
rule catalog_broadcast_inserted_unit_dims {
    X: [N]
     (attr_b: hlo.broadcast (axis_eval_0: hlo.broadcast X)) => (attr_out: hlo.broadcast X)
     where { [1,N] == [1,N] && attr_b.attrs.dimensions == [0,1]  && (axis_eval_0.attrs.dimensions == [1]) && (axis_eval_0.attrs.new_extents == [1])}
     
derive {
 attr_out.attrs = {dimensions: auto, new_extents: concat([1], attr_b.attrs.new_extents)};
}
}
