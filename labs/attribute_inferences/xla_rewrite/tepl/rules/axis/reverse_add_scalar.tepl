// Canonical axis-only evaluation task; no descriptor or non-axis inference.
from "dialects/hlo.tepl" import HLO as hlo;
use hlo::{add, mul, negate, subtract, zero_like, transpose, broadcast,
        reduce_sum, reverse, slice, dot};

rule reverse_add_scalar {
    (attr_r: reverse (add X (attr_b: broadcast C))) => (add (axis_eval_0: reverse X) (axis_eval_1: broadcast C))
    where { attr_b.attrs.dimensions == [] }
derive {
 axis_eval_0.attrs = {dimensions: auto};
 axis_eval_1.attrs = {dimensions: auto, new_extents: attr_b.attrs.new_extents};
}
}
