from "dialects/hlo.tepl" import HLO as hlo

// Catalog: reduction-reshape-free
// Scope: Rank-three input; sum over first axis while reshape merges free axes.
// Source arithmetic/applicability conditions are recorded in the manifest.
rule catalog_reduction_reshape_free {
  X: [A, B, C]

  (attr_r: hlo.reduce_sum (attr_s: hlo.reshape X))
  =>
  (attr_out: hlo.reshape (hlo.reduce_sum[attr_r.attrs] X))

  where
    attr_s.attrs.shape == [A, B * C] && attr_r.attrs.dimensions == [0] derive {
    attr_out.attrs = { shape: [B * C] }
  }
}
