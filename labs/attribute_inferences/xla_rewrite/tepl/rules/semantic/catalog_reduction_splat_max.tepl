from "dialects/hlo.tepl" import HLO as hlo;

// Catalog: reduction-splat-max
// Scope: Arbitrary tensor shapes under the catalog arithmetic/applicability assumptions.
// Source arithmetic/applicability conditions are recorded in the manifest.
rule catalog_reduction_splat_max {
    X: [] Init: []
     (attr_r: hlo.reduce_max (attr_b: hlo.broadcast X) Init) => (hlo.maximum X Init)
     where { attr_b.attrs.dimensions==[] && product(attr_b.attrs.new_extents)>0 && attr_r.attrs.dimensions==range(len(attr_b.attrs.new_extents)) }
}
