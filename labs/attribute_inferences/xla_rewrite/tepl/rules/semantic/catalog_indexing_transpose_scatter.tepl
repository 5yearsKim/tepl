from "dialects/hlo.tepl" import HLO as hlo;

// Catalog: indexing-transpose-scatter
// Scope: Rank-two operand, rank-three updates with leading scatter axis, no batching.
// Source arithmetic/applicability conditions are recorded in the manifest.
rule catalog_indexing_transpose_scatter {
    (attr_p: hlo.transpose (attr_s: hlo.scatter X Indices Updates))
     => (attr_out: hlo.scatter (hlo.transpose[attr_p.attrs] X) Indices (attr_up: hlo.transpose Updates))
     where { attr_p.attrs.permutation==[1,0] && attr_s.attrs.input_batching_dims==[] && attr_s.attrs.scatter_indices_batching_dims==[] && attr_s.attrs.update_window_dims==[1,2] && attr_s.attrs.inserted_window_dims==[] && attr_s.attrs.scatter_dims_to_operand_dims==[0] && attr_s.attrs.index_vector_dim==1 }
     derive { attr_out.attrs={..attr_s.attrs,scatter_dims_to_operand_dims:[1]}; attr_up.attrs={permutation:[0,2,1]}; }
}
