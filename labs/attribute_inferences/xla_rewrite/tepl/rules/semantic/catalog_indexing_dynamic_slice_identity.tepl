from "dialects/hlo.tepl" import HLO as hlo

// Catalog: indexing-dynamic-slice-identity
// Scope: Rank-one full-shape dynamic slice.
// Source arithmetic/applicability conditions are recorded in the manifest.
rule catalog_indexing_dynamic_slice_identity {
  X: [N]

  (attr_s: hlo.dynamic_slice X Start) => X

  where attr_s.attrs.sizes == [N]
}
