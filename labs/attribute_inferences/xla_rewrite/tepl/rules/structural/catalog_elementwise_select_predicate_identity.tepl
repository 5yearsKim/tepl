from "dialects/hlo_structural.tepl" import HLO as hlo

// Catalog: elementwise-select-predicate-identity
// Scope: Scalar literal instance; source conditions retained in the catalog.
// Source arithmetic/applicability conditions are recorded in the manifest.
rule catalog_elementwise_select_predicate_identity {
  P: bool[]

  (hlo.select P 1:bool 0:bool) => P
}
