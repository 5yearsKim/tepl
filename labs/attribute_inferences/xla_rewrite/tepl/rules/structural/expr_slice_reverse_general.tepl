from "dialects/hlo_structural.tepl" import HLO as hlo

// Expression check under the source conditions recorded in the catalog.
rule expr_slice_reverse_general {
  X: [Dims...]

  (attr_s: hlo.slice (attr_r: hlo.reverse X))
  =>
  (hlo.reverse[attr_r.attrs] (attr_out: hlo.slice X))

  where all([n > 0 for n in attr_s.attrs.sizes]) derive {
    attr_out.attrs = {
      ..attr_s.attrs,
      starts: [
        if contains(attr_r.attrs.dimensions, i)
          then i64(
            Dims[i]
              - 1
              - (
                u64(attr_s.attrs.starts[i])
                  + (attr_s.attrs.sizes[i] - 1) * u64(attr_s.attrs.strides[i])
              )
          )
          else attr_s.attrs.starts[i]
        for i in range(len(Dims))
      ]
    }
  }
}
