from "dialects/hlo_structural.tepl" import HLO as hlo

// Expression check under the source conditions recorded in the catalog.
rule expr_reverse_compose_general {
  (attr_outer: hlo.reverse (attr_inner: hlo.reverse X))
  =>
  (attr_out: hlo.reverse X)

  derive {
    attr_out.attrs = {
      dimensions: concat(
        exclude(attr_inner.attrs.dimensions, attr_outer.attrs.dimensions),
        exclude(attr_outer.attrs.dimensions, attr_inner.attrs.dimensions)
      )
    }
  }
}
