from "dialects/hlo_structural.tepl" import HLO as hlo;

// Catalog: indexing-reverse-inserted-unit-dims
// Scope: Insert one leading unit axis into rank-one input.
// Source arithmetic/applicability conditions are recorded in the manifest.
rule catalog_indexing_reverse_inserted_unit_dims {
    X: [N]
     (attr_r: hlo.reverse (attr_shape: hlo.reshape X)) => (hlo.reshape[attr_shape.attrs] (attr_out: hlo.reverse X))
     where { attr_shape.attrs.shape==[1,N] }
     derive { attr_out.attrs={dimensions:[d-1 for d in exclude(attr_r.attrs.dimensions,[0])]}; }
}
