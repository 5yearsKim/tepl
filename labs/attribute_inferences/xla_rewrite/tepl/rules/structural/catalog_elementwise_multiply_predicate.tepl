from "dialects/hlo_structural.tepl" import HLO as hlo;

// Catalog: elementwise-multiply-predicate
// Scope: Written operand/opcode variant under the catalog conditions.
// Source arithmetic/applicability conditions are recorded in the manifest.
rule catalog_elementwise_multiply_predicate {
    X: [Dims...] (hlo.multiply (attr_c: hlo.convert P) X) => (hlo.select P X (hlo.zero_like X))
}
