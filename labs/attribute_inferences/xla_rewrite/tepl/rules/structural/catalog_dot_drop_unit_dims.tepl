from "dialects/hlo_structural.tepl" import HLO as hlo

// Catalog: dot-drop-unit-dims
// Scope: Remove a leading free unit axis from a rank-three left operand.
// Source arithmetic/applicability conditions are recorded in the manifest.
rule catalog_dot_drop_unit_dims {
  X: [One, M, K]
  Y: [K, N]

  (attr_d: hlo.dot X Y)
  =>
  (attr_out: hlo.reshape (attr_new: hlo.dot (attr_left: hlo.reshape X) Y))

  where
    One == 1
      && attr_d.attrs.lhs_batching_dimensions == []
      && attr_d.attrs.rhs_batching_dimensions == []
      && attr_d.attrs.lhs_contracting_dimensions == [2]
      && attr_d.attrs.rhs_contracting_dimensions == [0] derive {
    attr_left.attrs = { shape: [M, K] }
    attr_new.attrs = {
      lhs_batching_dimensions: [],
      rhs_batching_dimensions: [],
      lhs_contracting_dimensions: [1],
      rhs_contracting_dimensions: [0]
    }
    attr_out.attrs = { shape: [1, M, N] }
  }
}
