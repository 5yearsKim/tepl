from "dialects/hlo_structural.tepl" import HLO as hlo;
graph pointwise_convolution {
    input X: f32[2,3,2];
    input W: f32[1,2,2];
    yield (hlo.general_convolution[
        window_strides=[1],padding_low=[0],padding_high=[0],
        lhs_dilation=[1],rhs_dilation=[1],window_reversal=[false],
        input_batch_dimension=0,input_feature_dimension=2,input_spatial_dimensions=[1],
        kernel_input_feature_dimension=1,kernel_output_feature_dimension=2,kernel_spatial_dimensions=[0],
        output_batch_dimension=0,output_feature_dimension=2,output_spatial_dimensions=[1],
        feature_group_count=1,batch_group_count=1,
        precision_config=[default,default],shape=[2,3,2]] X W);
}
