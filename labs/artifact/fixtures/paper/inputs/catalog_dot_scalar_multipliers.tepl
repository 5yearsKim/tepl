// Canonical axis-only evaluation task; no descriptor or non-axis inference.
from "dialects/hlo.tepl" import HLO as hlo;

// Catalog: dot-scalar-multipliers
// Scope: Scalar factor pulled from a rank-two f32 dot; source constant/profitability screening is outside the algebraic identity.
// Source arithmetic/applicability conditions are recorded in the manifest.
rule catalog_dot_scalar_multipliers {
    X: f32[M,K] Y: f32[K,N] Scale: f32[]
     (attr_d: hlo.dot (hlo.multiply (attr_b: hlo.broadcast Scale) X) Y) => (hlo.multiply (attr_out: hlo.broadcast Scale) (axis_eval_0: hlo.dot X Y))
     where { attr_b.attrs.dimensions==[] && attr_b.attrs.new_extents==[M,K] && attr_d.attrs.lhs_batching_dimensions==[] && attr_d.attrs.rhs_batching_dimensions==[] && attr_d.attrs.lhs_contracting_dimensions==[1] && attr_d.attrs.rhs_contracting_dimensions==[0] }
     
derive {
 attr_out.attrs = {dimensions: auto, new_extents: [M,N]};
 axis_eval_0.attrs = {lhs_contracting_dimensions: auto, rhs_contracting_dimensions: auto, lhs_batching_dimensions: auto, rhs_batching_dimensions: auto};
}
}
