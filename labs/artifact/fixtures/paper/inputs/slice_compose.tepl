// Canonical axis-only evaluation task; no descriptor or non-axis inference.
from "dialects/hlo.tepl" import HLO as hlo;
use hlo::{add, mul, negate, subtract, zero_like, transpose, broadcast,
        reduce_sum, reverse, slice, dot};

rule slice_compose {
    X: [N]
    (attr_outer: slice (attr_inner: slice X)) => (attr_out: slice X)
    where { attr_inner.attrs.strides == [1] && attr_outer.attrs.strides == [1] }
    
derive {
 attr_out.attrs = {starts: [attr_inner.attrs.starts[0] + attr_outer.attrs.starts[0]], sizes: attr_outer.attrs.sizes, strides: [1]};
}
}
