from "../../../../xla_rewrite/tepl/dialects/hlo.tepl" import HLO as hlo;

// Expression check under the source conditions recorded in the catalog.
rule expr_slice_reverse_general {
    X: [Dims...] (hlo.slice[@s] (hlo.reverse[@r] X)) => (hlo.reverse[auto] (hlo.slice[auto] X)) where { all([n > 0 for n in @s.sizes]) }
}
