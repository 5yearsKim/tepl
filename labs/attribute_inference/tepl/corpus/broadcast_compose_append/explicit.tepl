from "../../../../xla_rewrite/tepl/dialects/hlo.tepl" import HLO as hlo;
use hlo::{broadcast};

rule broadcast_compose_append {
    X: [Dims...]
    (broadcast[@outer] (broadcast[@inner] X)) => (broadcast[@out] X)
    where { @inner.dimensions == range(len(Dims))
         && @outer.dimensions == range(len(Dims) + len(@inner.new_extents)) }
    derive { @out = { dimensions: @inner.dimensions,
        new_extents: concat(@inner.new_extents, @outer.new_extents) }; }
}
