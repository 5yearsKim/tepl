from "../../../../xla_rewrite/tepl/dialects/hlo.tepl" import HLO as hlo;

// Catalog: elementwise-compare-max
// Scope: Written operand/opcode variant under the catalog conditions.
// Source arithmetic/applicability conditions are recorded in the manifest.
rule catalog_elementwise_compare_max {
    (hlo.compare[@c] (hlo.maximum A B) A) => (hlo.compare[@c] B A)
     where { @c.direction == 3 }
}
