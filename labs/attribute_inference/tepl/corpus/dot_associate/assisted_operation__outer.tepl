from "../../../../xla_rewrite/tepl/dialects/hlo.tepl" import HLO as hlo;
use hlo::{add, mul, negate, subtract, zero_like, transpose, broadcast,
        reduce_sum, reverse, slice, dot};

rule dot_associate {
    X: [M, K]
    Y: [K, N]
    Z: [N, P]
    (dot[@outer] (dot[@inner] X Y) Z) => (dot[@inner] X (dot[auto] Y Z))
    where { @inner.lhs_batching_dimensions == []
         && @inner.rhs_batching_dimensions == []
         && @inner.lhs_contracting_dimensions == [1]
         && @inner.rhs_contracting_dimensions == [0]
         && @outer.lhs_batching_dimensions == []
         && @outer.rhs_batching_dimensions == []
         && @outer.lhs_contracting_dimensions == [1]
         && @outer.rhs_contracting_dimensions == [0] }
}
