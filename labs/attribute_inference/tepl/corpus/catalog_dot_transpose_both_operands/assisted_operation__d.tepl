from "../../../../xla_rewrite/tepl/dialects/hlo.tepl" import HLO as hlo;

// Catalog: dot-transpose-both-operands
// Scope: Rank-two matrix transposes, no batches.
// Source arithmetic/applicability conditions are recorded in the manifest.
rule catalog_dot_transpose_both_operands {
    X: [K,M] Y: [N,K]
     (hlo.dot[@d] (hlo.transpose[@p] X) (hlo.transpose[@q] Y)) => (hlo.transpose[@p] (hlo.dot[auto] Y X))
     where { @p.permutation==[1,0] && @q.permutation==[1,0] && @d.lhs_batching_dimensions==[] && @d.rhs_batching_dimensions==[] && @d.lhs_contracting_dimensions==[1] && @d.rhs_contracting_dimensions==[0] }
}
