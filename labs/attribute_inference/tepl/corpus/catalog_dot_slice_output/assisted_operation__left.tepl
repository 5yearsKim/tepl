from "../../../../xla_rewrite/tepl/dialects/hlo.tepl" import HLO as hlo;

// Catalog: dot-slice-output
// Scope: Rank-two dot with arbitrary output starts, sizes and positive strides.
// Source arithmetic/applicability conditions are recorded in the manifest.
rule catalog_dot_slice_output {
    X: [M,K] Y: [K,N]
     (hlo.slice[@s] (hlo.dot[@d] X Y)) => (hlo.dot[@d] (hlo.slice[auto] X) (hlo.slice[@right] Y))
     where { @d.lhs_batching_dimensions==[] && @d.rhs_batching_dimensions==[] && @d.lhs_contracting_dimensions==[1] && @d.rhs_contracting_dimensions==[0] }
     derive {
        @right={starts:[0,@s.starts[1]],sizes:[K,@s.sizes[1]],strides:[1,@s.strides[1]]};
    }
}
