from "../../../../xla_rewrite/tepl/dialects/hlo.tepl" import HLO as hlo;
use hlo::{slice};

rule slice_compose_zero_starts {
    (slice[@outer] (slice[@inner] X)) => (slice[auto, starts = [0], strides = [1]] X)
    where { @inner.starts == [0] && @outer.starts == [0]
         && @inner.strides == [1] && @outer.strides == [1] }
}
