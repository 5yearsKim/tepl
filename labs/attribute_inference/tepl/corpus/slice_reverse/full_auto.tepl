from "../../../../xla_rewrite/tepl/dialects/hlo.tepl" import HLO as hlo;
use hlo::{add, mul, negate, subtract, zero_like, transpose, broadcast,
        reduce_sum, reverse, slice, dot};

rule slice_reverse {
    X: [N]
    (slice[@s] (reverse[@r] X)) => (reverse[auto] (slice[auto] X))
    where { @r.dimensions == [0] && @s.strides == [1] }

}
