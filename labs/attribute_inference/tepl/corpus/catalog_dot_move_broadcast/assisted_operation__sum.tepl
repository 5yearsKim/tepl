from "../../../../xla_rewrite/tepl/dialects/hlo.tepl" import HLO as hlo;

// Catalog: dot-move-broadcast
// Scope: One broadcast-created contraction axis; replacement dot is an outer product.
// Source arithmetic/applicability conditions are recorded in the manifest.
rule catalog_dot_move_broadcast {
    X: [K] Y: [J,N]
     (hlo.dot[@d] (hlo.broadcast[@b] X) Y) => (hlo.dot[@out] X (hlo.reduce_sum[auto] Y))
     where { @b.dimensions==[0] && @b.new_extents==[J] && @d.lhs_batching_dimensions==[] && @d.rhs_batching_dimensions==[] && @d.lhs_contracting_dimensions==[1] && @d.rhs_contracting_dimensions==[0] }
     derive {
        @out={lhs_batching_dimensions:[],rhs_batching_dimensions:[],lhs_contracting_dimensions:[],rhs_contracting_dimensions:[]};
    }
}
