from "../../../../xla_rewrite/tepl/dialects/hlo.tepl" import HLO as hlo;
use hlo::{add, mul, negate, subtract, zero_like, transpose, broadcast,
        reduce_sum, reverse, slice, dot};

rule dot_move_reverse {
    X: [K]
    Y: [K]
    (dot[@d] (reverse[@r] X) Y) => (dot[@d] X (reverse[auto] Y))
    where { @r.dimensions == [0]
         && @d.lhs_batching_dimensions == [] && @d.rhs_batching_dimensions == []
         && @d.lhs_contracting_dimensions == [0]
         && @d.rhs_contracting_dimensions == [0] }
}
