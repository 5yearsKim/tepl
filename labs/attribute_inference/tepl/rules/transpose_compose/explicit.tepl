from "../../../../xla_rewrite/tepl/dialects/hlo.tepl" import HLO as hlo;
use hlo::{add, mul, negate, subtract, zero_like, transpose, broadcast,
        reduce_sum, reverse, slice, dot};

rule transpose_compose {
    (transpose[@outer] (transpose[@inner] X)) => (transpose[@combined] X)
    derive {
        @combined = { ..@outer,
            permutation: gather(@inner.permutation, @outer.permutation) };
    }
}
