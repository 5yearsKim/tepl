        "rule/declarations.cc",
        "rule/declarations.h",
        "rule/descriptors.cc",
        "rule/descriptors.h",
        "rule/expand.cc",
        "rule/expand.h",
        "rule/expanded_rule.h",
        "rule/expression.cc",
        "rule/expression.h",
        "rule/graph.cc",
        "rule/graph.h",
        "rule/resolve.cc",
        "rule/resolve.h",
        "rule/scope.h",
