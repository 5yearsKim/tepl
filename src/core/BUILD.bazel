load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_import.bzl", "cc_import")
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")

# The pinned BCR package exports only libz3.so although its ELF SONAME is
# libz3.so.4.15. Include the SONAME in Bazel's solib directory and runfiles.
genrule(
    name = "z3_soname",
    srcs = ["@z3//:z3_dynamic"],
    outs = ["libz3.so.4.15"],
    cmd = "for file in $(locations @z3//:z3_dynamic); do case $$file in */libz3.so) cp $$file $@ ;; esac; done",
)

cc_import(
    name = "z3_soname_import",
    shared_library = ":z3_soname",
)

cc_library(
    name = "z3_solver",
    deps = ["@z3//:z3", ":z3_soname_import"],
)

cc_library(
    name = "ir",
    srcs = [
        "builtins/catalog.cc",
        "semantics/ir.cc",
        "metadata/types.cc",
        "type/literal.cc",
        "type/types.cc",
    ],
    hdrs = [
        "builtins/catalog.h",
        "ids.h",
        "semantics/ir.h",
        "inference/ir.h",
        "inference/semantic_ir.h",
        "ir.h",
        "metadata/ir.h",
        "metadata/types.h",
        "type/literal.h",
        "type/types.h",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//:operators",
        "//:source",
    ],
)

