# Compatibility label/header used by unchanged code generators. Serialization
# is pure and does not link the legacy solver or Z3 into the compiler binary.
cc_library(
    name = "semantic_solver",
    hdrs = ["semantics/solver.h"],
    deps = ["//src/legacy_semantics:codec"],
    visibility = ["//visibility:public"],
)

# Preserve the library filename loaded by existing generated applications.
cc_binary(
    name = "libtepl_semantic_runtime.so",
    srcs = ["//src/legacy_semantics:runtime.cc"],
    deps = ["//src/legacy_semantics:solver"],
    linkshared = True,
    visibility = ["//visibility:public"],
)
