load("@rules_cc//cc:cc_binary.bzl", "cc_binary")

load("@rules_cc//cc:cc_library.bzl", "cc_library")

load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

exports_files(glob(["examples/**/*.tepl"]) + ["docs/references/built-ins.md"])

cc_binary(
    name = "tepl",
    srcs = ["src/cli/main.cc", "src/cli/semantic_report.cc", "src/cli/semantic_report.h"],
    visibility = ["//tests:__pkg__"],
    deps = [
        "//src/core:pipeline",
        "//src/core/syntax:syntax",
        "//src/core/resolution",
        "//src/core/semantics:report",
        "//src/support:init",
        "//src/executable",
        "//src/rewrite:cli",
        "@cli11//:cli11",
    ],
)

sh_binary(name = "format", srcs = ["tools/format.sh"])

cc_binary(
    name = "embed_templates",
    srcs = ["tools/embed_templates.cc"],
    visibility = ["//src/codegen:__pkg__"],
)

cc_binary(
    name = "builtin_reference",
    visibility = ["//tests:__pkg__"],
    srcs = ["tools/builtin_reference.cc"],
    deps = ["//src/shared/builtins", "//src/shared/builtins:intrinsics"],
)
