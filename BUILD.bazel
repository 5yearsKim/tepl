load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

sh_binary(
    name = "format",
    srcs = ["tools/format.sh"],
)

sh_binary(
    name = "format_check",
    srcs = ["tools/format.sh"],
    args = ["--check"],
)

cc_library(
    name = "ast",
    srcs = ["src/ast_print.cc"],
    hdrs = ["src/ast.h", "src/ast_print.h"],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "frontend",
    srcs = ["src/ast_builder.cc", "src/parse.cc"],
    hdrs = ["src/ast_builder.h", "src/parse.h"],
    visibility = ["//visibility:public"],
    deps = [":ast", "//grammar:parser"],
)

cc_binary(
    name = "tepl",
    srcs = ["src/main.cc"],
    visibility = ["//tests:__pkg__"],
    deps = [
        ":ast",
        ":frontend",
        "@cli11//:cli11",
    ],
)
