load("@rules_cc//cc:cc_binary.bzl", "cc_binary")

load("@rules_cc//cc:cc_library.bzl", "cc_library")

load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

exports_files(glob(["examples/**/*.tepl", "examples/**/tepl.toml"]) + ["docs/references/built-ins.md"])

cc_binary(
    name = "tepl",
    srcs = ["src/cli/main.cc", "src/cli/semantic_report.cc", "src/cli/semantic_report.h", "src/cli/core_emission.cc", "src/cli/core_emission.h"],
    visibility = ["//tests:__pkg__"],
    deps = [
        "//src/core:pipeline",
        "//src/core/attr_synth:ordered",
        "@nlohmann_json//:json",
        "//src/codegen",
        "//src/codegen:write",
        "//src/core/syntax:syntax",
        "//src/core/resolution",
        "//src/core/semantics:report",
        "//src/support:init",
        "//src/support:project_config",
        "//src/executable",
        "//src/rewrite:cli",
        "@cli11//:cli11",
    ],
)

sh_binary(name = "format", srcs = ["tools/format.sh"])

cc_binary(
    name = "builtin_reference",
    visibility = ["//tests:__pkg__"],
    srcs = ["tools/builtin_reference.cc"],
    deps = ["//src/shared/builtins", "//src/shared/builtins:intrinsics"],
)

filegroup(
    name = "rust_codegen_sources",
    srcs = glob(["examples/semantic/**/*.tepl", "examples/semantic/**/tepl.toml", "examples/sample/**/*.tepl", "examples/sample/**/tepl.toml"]) + ["tools/test_codegen.sh"],
    visibility = ["//tests:__pkg__"],
)

filegroup(
    name = "cpp_codegen_sources",
    srcs = ["//runtime/cpp:sources", "tools/test_codegen_cpp.sh", ":rust_codegen_sources"],
    visibility = ["//tests:__pkg__"],
)
