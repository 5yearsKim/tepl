load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
cc_library(
    name = "runtime",
    hdrs = glob(["include/**/*.h"]),
    includes = ["include"],
    deps = ["@eggc//:eggc"],
    visibility = ["//visibility:public"],
)
cc_test(
    name = "values_test",
    srcs = ["tests/values.cc"],
    deps = [":runtime"],
)

filegroup(
    name = "sources",
    srcs = glob(["include/**/*.h", "tests/*.cc"]),
    visibility = ["//visibility:public"],
)
